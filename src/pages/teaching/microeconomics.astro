---
import { getCollection } from 'astro:content';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Hero from '../../components/marketing/Hero.astro';
import Section from '../../components/marketing/Section.astro';
import SectionHeading from '../../components/marketing/SectionHeading.astro';
import CTABand from '../../components/marketing/CTABand.astro';

const COURSE = 'microeconomics';

// Published topic index. Production build lists only `status: approved` topics;
// `astro dev` also previews drafts (see [topic].astro for the rationale).
const previewDrafts = import.meta.env.DEV;
const topics = (await getCollection('courses'))
  .filter((e) => e.id.split('/')[0] === COURSE)
  .filter(
    (e) => previewDrafts || (e.data.status ?? '').toLowerCase() === 'approved',
  )
  .map((e) => {
    // Order comes from the directory slug (t01, t03a, t03b…), which is
    // authoritative and always well-formed — NOT the `topic:` prose, whose
    // upstream label is inconsistent (T6/T10 carried the old lowercase bundled
    // name). The slug also encodes the a/b/c lecture split: t04a < t04b < t04c.
    const slug = e.id.split('/')[1];
    const m = slug.match(/^t(\d+)([a-z]?)/i);
    const num = m ? parseInt(m[1], 10) : 999;
    const part = m?.[2] ? m[2].toLowerCase().charCodeAt(0) - 96 : 0; // a=1,b=2,c=3
    return {
      slug,
      title: e.data.title,
      order: e.data.order ?? num * 100 + part,
      isDraft: (e.data.status ?? '').toLowerCase() !== 'approved',
    };
  })
  .sort((a, b) => a.order - b.order);
// Sequential lecture numbers (1..N) by published order. We number lectures, not
// upstream "T#" — several T-numbers span multiple lectures via a/b/c splits, so
// the shared "T3"/"T6" badge repeated and read as duplicate titles.
---
<MarketingLayout
  title="Micro-Economic Principles — Bryan Cutsinger"
  description="A topic-by-topic undergraduate microeconomics reader built on cause-and-effect reasoning, property rights, and political economy — with syllabus and slides. By Bryan Cutsinger."
>
  <Hero
    eyebrow="Course"
    headline="Micro-Economic Principles"
    subhead="The economic way of thinking — how prices, property rights, and incentives coordinate a world of scarcity, and why so many policies produce results their authors never intended."
  />

  <!-- Written overview -->
  <Section variant="surface" width="reading">
    <SectionHeading eyebrow="Overview" heading="About the course." />
    <div class="prose">
      <p>
        Microeconomics is the study of how scarce things get put to use — how
        individuals, firms, and policymakers respond to incentives and
        constraints, and how prices and property rights coordinate their choices
        without anyone directing the whole. The course builds that reasoning step
        by step: opportunity cost, thinking at the margin, the gains from
        voluntary exchange, and how competition, profits, and losses move
        resources to their highest-valued uses. Throughout, we judge policies by
        their consequences rather than their intentions, and ask of every
        outcome: who pays, and in what form?
      </p>
      <p>
        The same tools explain far more than markets. We turn them on the
        policies that shape markets — price controls, taxes, minimum wages,
        occupational licensing, antitrust — and treat politics itself as a
        marketplace, where concentrated benefits and dispersed costs explain why
        measures persist even when they fail their stated goals. The emphasis is
        on plain cause-and-effect reasoning and real-world examples, not formal
        apparatus.
      </p>
      <p>
        The course is organized as a series of short, self-contained readers —
        one per topic, in sequence below. Each is written to stand on its own,
        with the figures and tables built in.
      </p>
    </div>
  </Section>

  <!-- Topic index -->
  <Section variant="raised">
    <SectionHeading
      eyebrow="Topics"
      heading="The course, topic by topic."
      lede="Read in order or jump to a topic. More are added as they're finalized."
    />
    {
      topics.length > 0 ? (
        <ol class="topics">
          {topics.map((t, i) => (
            <li class="topics__item">
              <a class="topics__link" href={`/teaching/${COURSE}/${t.slug}/`}>
                <span class="topics__lecture">Lecture {i + 1}:</span>
                <span class="topics__title">{t.title}</span>
                {t.isDraft && <span class="topics__draft">Draft</span>}
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="topics__empty">
          Topics are being finalized and will appear here as they're published.
          In the meantime, <a href="/contact/">get in touch</a> for materials.
        </p>
      )
    }
  </Section>

  <CTABand
    heading="Questions about the course?"
    cta={{ label: 'Get in touch', href: '/contact/' }}
  />
</MarketingLayout>

<style>
  .prose p {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text);
    margin: 0 0 var(--sp-6);
  }
  .prose p:last-child {
    margin-bottom: 0;
  }

  /* Ordered topic index — quiet rows that lift slightly on hover. */
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }
  .topics__item {
    border-bottom: 1px solid var(--hairline);
  }
  .topics__link {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-4) var(--sp-2);
    text-decoration: none;
    color: var(--ink);
    transition: background-color 0.15s ease, padding-left 0.15s ease;
  }
  .topics__link:hover {
    background: var(--surface);
    padding-left: var(--sp-4);
  }
  /* "Lecture N:" — small accent label on its own line above the title. */
  .topics__lecture {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  .topics__title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .topics__link:hover .topics__title {
    color: var(--accent-hover);
  }
  .topics__draft {
    align-self: flex-start;
    margin-top: var(--sp-1);
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 0.1em 0.5em;
  }
  .topics__empty {
    font-size: 1.05rem;
    color: var(--text-muted);
  }
</style>
