---
import { getCollection } from 'astro:content';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Hero from '../../components/marketing/Hero.astro';
import Section from '../../components/marketing/Section.astro';
import SectionHeading from '../../components/marketing/SectionHeading.astro';
import DownloadCard from '../../components/marketing/DownloadCard.astro';
import CTABand from '../../components/marketing/CTABand.astro';

const COURSE = 'price-theory';

// Published topic index. Production build lists only `status: approved` topics;
// `astro dev` also previews drafts (see [topic].astro for the rationale).
const previewDrafts = import.meta.env.DEV;
const topics = (await getCollection('courses'))
  .filter((e) => e.id.split('/')[0] === COURSE)
  .filter(
    (e) => previewDrafts || (e.data.status ?? '').toLowerCase() === 'approved',
  )
  .map((e) => {
    const code = (e.data.topic ?? '').match(/T\d+/)?.[0] ?? '';
    const num = parseInt(code.replace(/\D/g, '') || '999', 10);
    return {
      slug: e.id.split('/')[1],
      title: e.data.title,
      code,
      order: e.data.order ?? num,
      isDraft: (e.data.status ?? '').toLowerCase() !== 'approved',
    };
  })
  .sort((a, b) => a.order - b.order);
---
<MarketingLayout
  title="Price Theory — Bryan Cutsinger"
  description="Overview and course materials for Bryan Cutsinger's Price Theory course — a topic-by-topic reader, syllabus, and slides."
>
  <!-- PLACEHOLDER copy — Bryan to confirm overview line. -->
  <Hero
    eyebrow="Course"
    headline="Price Theory"
    subhead="PLACEHOLDER — a one-line description of the course goes here."
  />

  <!-- Written overview -->
  <Section variant="surface" width="reading">
    <SectionHeading eyebrow="Overview" heading="About the course." />
    <div class="prose">
      <!-- PLACEHOLDER — Bryan to replace with the real course overview. -->
      <p>
        Course overview coming soon. Check back, or
        <a href="/contact/">get in touch</a> for materials in the meantime.
      </p>
    </div>
  </Section>

  <!-- Topic index -->
  <Section variant="raised">
    <SectionHeading
      eyebrow="Topics"
      heading="The course, topic by topic."
      lede="Read in order or jump to a topic. More are added as they're finalized."
    />
    {
      topics.length > 0 ? (
        <ol class="topics">
          {topics.map((t) => (
            <li class="topics__item">
              <a class="topics__link" href={`/teaching/${COURSE}/${t.slug}/`}>
                {t.code && <span class="topics__badge">{t.code}</span>}
                <span class="topics__title">{t.title}</span>
                {t.isDraft && <span class="topics__draft">Draft</span>}
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="topics__empty">
          Topics are being finalized and will appear here as they're published.
          In the meantime, <a href="/contact/">get in touch</a> for materials.
        </p>
      )
    }
  </Section>

  <!-- Materials (downloads) -->
  <Section variant="surface">
    <SectionHeading
      eyebrow="Materials"
      heading="Course materials."
      lede="You're welcome to use or adapt these. Files marked “request” aren't posted yet — reach out and I'll send them."
    />
    <div class="materials">
      <!-- PLACEHOLDER — drop a real PDF in public/downloads/ and set fileUrl. -->
      <DownloadCard
        title="Syllabus"
        description="Course outline, policies, and the schedule of topics."
        downloadLabel="Download the syllabus (PDF)"
        requestLabel="Request the syllabus"
      />
    </div>
  </Section>

  <CTABand
    heading="Questions about the course or its materials?"
    cta={{ label: 'Get in touch', href: '/contact/' }}
  />
</MarketingLayout>

<style>
  .prose p {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text);
    margin: 0 0 var(--sp-6);
  }
  .prose p:last-child {
    margin-bottom: 0;
  }

  /* Ordered topic index — quiet rows that lift slightly on hover. */
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }
  .topics__item {
    border-bottom: 1px solid var(--hairline);
  }
  .topics__link {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-2);
    text-decoration: none;
    color: var(--ink);
    transition: background-color 0.15s ease, padding-left 0.15s ease;
  }
  .topics__link:hover {
    background: var(--surface);
    padding-left: var(--sp-4);
  }
  .topics__badge {
    flex: none;
    min-width: 2.5rem;
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  .topics__title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .topics__link:hover .topics__title {
    color: var(--accent-hover);
  }
  .topics__draft {
    flex: none;
    margin-left: auto;
    align-self: center;
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 0.1em 0.5em;
  }
  .topics__empty {
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .materials {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }
</style>
