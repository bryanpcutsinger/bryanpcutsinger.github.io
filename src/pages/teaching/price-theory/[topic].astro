---
// Per-topic problem listing for the Price Theory bank. One route per taxonomy
// topic that has ≥1 problem; renders each matching problem as a card with its
// question text, source provenance + back-link, subtopics, and (rarely) a
// solution. Data comes from the generated copy of bryanpcutsinger/price-theory
// (src/data/price-theory/*.json — refresh with `npm run import:problems`).
//
import problemsDoc from '../../../data/price-theory/problems.json';
import taxonomy from '../../../data/price-theory/taxonomy.json';
import MarketingLayout from '../../../layouts/MarketingLayout.astro';
import Eyebrow from '../../../components/marketing/Eyebrow.astro';
import CTABand from '../../../components/marketing/CTABand.astro';
import 'katex/dist/katex.min.css';
import {
  COURSE,
  examContext,
  groupBySourceYear,
  humanize,
  isStated,
  optionLabel,
  paragraphs,
  provenance,
  renderInlineMath,
} from '../../../lib/priceTheory';

export async function getStaticPaths() {
  const topics: Record<string, any> = taxonomy.topics;
  const problems = problemsDoc.problems;
  return Object.entries(topics)
    .map(([key, t]) => ({
      key,
      label: t.label,
      items: problems.filter((p) => (p.topics ?? []).includes(key)),
    }))
    .filter((x) => x.items.length > 0)
    .map((x) => ({
      params: { topic: x.key },
      props: { topicKey: x.key, label: x.label, items: x.items },
    }));
}

const { topicKey, label, items } = Astro.props;
const groups = groupBySourceYear(items);
const topicSubtopics = taxonomy.topics[topicKey]?.subtopics ?? [];
const presentSubtopics = new Set(items.flatMap((p: any) => p.subtopics ?? []));
const subtopics = topicSubtopics
  .filter((subtopic: string) => presentSubtopics.has(subtopic))
  .sort((a, b) => humanize(a).localeCompare(humanize(b)));
---
<MarketingLayout
  title={`${label} — Price Theory — Bryan Cutsinger`}
  description={`${items.length} classic price theory problem${items.length === 1 ? '' : 's'} on ${label.toLowerCase()}, with source attribution.`}
>
  <article class="bank">
    <header class="bank__head">
      <Eyebrow text={`Price Theory · ${label}`} />
      <h1>{label}</h1>
      <p class="bank__count">
        {items.length} problem{items.length === 1 ? '' : 's'}
      </p>
      <p class="bank__intro">
        Historical wording is preserved as archival text. Exam-only point
        values, time limits, and outer question numbers are omitted for use as a
        question bank.
      </p>
    </header>

    <nav class="bank-tools" aria-label={`${label} filters and source groups`}>
      {subtopics.length > 0 && (
        <div class="bank-tools__block">
          <h2>Filter by subtopic</h2>
          <div class="chip-row" data-topic-chips>
            <button class="chip chip--button is-active" type="button" data-chip-value="">
              All
            </button>
            {subtopics.map((subtopic) => (
              <button
                class="chip chip--button"
                type="button"
                data-chip-value={subtopic}
              >
                {optionLabel(subtopic)}
              </button>
            ))}
          </div>
        </div>
      )}

      <div class="bank-tools__block">
        <h2>Jump to source</h2>
        <div class="source-jumps">
          {groups.map((group) => (
            <a href={`#${group.id}`}>{group.label}</a>
          ))}
        </div>
      </div>
    </nav>

    <p class="bank__count bank__count--live" aria-live="polite" data-topic-count>
      Showing {items.length} problem{items.length === 1 ? '' : 's'}
    </p>

    <div class="source-groups">
      {
        groups.map((group) => (
          <section class="source-group" id={group.id} data-source-group>
            <h2>{group.label}</h2>
            <ol class="problems">
              {group.items.map((p: any) => (
                <li
                  class="problem"
                  id={p.id}
                  data-problem
                  data-subtopics={(p.subtopics ?? []).join(' ')}
                >
                  <div class="problem__q">
                    {paragraphs(p.question_text).map((para) => (
                      <p set:html={renderInlineMath(para)} />
                    ))}
                  </div>

                  <p class="problem__meta">
                    <span class="problem__source">{provenance(p.source)}</span>
                    {examContext(p.exam_context) && (
                      <span class="problem__tag">{examContext(p.exam_context)}</span>
                    )}
                    {p.source?.web_source?.url && (
                      <a
                        class="problem__src-link"
                        href={p.source.web_source.url}
                        rel="noopener"
                      >
                        source
                      </a>
                    )}
                  </p>

                  {p.subtopics?.length > 0 && (
                    <p class="problem__subtopics">
                      {p.subtopics.map((s: string) => (
                        <button
                          class="chip chip--button"
                          type="button"
                          data-chip-value={s}
                        >
                          {optionLabel(s)}
                        </button>
                      ))}
                    </p>
                  )}

                  {isStated(p.solution) && (
                    <details class="problem__solution">
                      <summary>Show solution</summary>
                      {paragraphs(p.solution).map((para) => (
                        <p set:html={renderInlineMath(para)} />
                      ))}
                    </details>
                  )}
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    <p class="bank__empty" hidden data-topic-empty>
      No problems in {label.toLowerCase()} match that subtopic.
    </p>

    <p class="bank__back">
      <a href={`/teaching/${COURSE}/`}>← Back to Price Theory</a>
    </p>
  </article>

  <CTABand
    heading="Want these as a problem set, or have one to add?"
    cta={{ label: 'Get in touch', href: '/contact/' }}
  />
</MarketingLayout>

<style>
  .bank {
    max-width: var(--reading);
    margin-inline: auto;
    padding: var(--sp-16) var(--sp-6) var(--sp-24);
  }
  .bank__head {
    margin-bottom: var(--sp-12);
  }
  .bank__head h1 {
    font-size: var(--fs-display-lg);
    max-width: 18ch;
  }
  .bank__count {
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .bank__count--live {
    margin: 0 0 var(--sp-6);
  }
  .bank__intro {
    color: var(--text-muted);
    margin-top: var(--sp-6);
  }

  .bank-tools {
    border-block: 1px solid var(--hairline);
    padding-block: var(--sp-6);
    margin-bottom: var(--sp-8);
    display: grid;
    gap: var(--sp-6);
  }
  .bank-tools__block h2,
  .source-group h2 {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 var(--sp-3);
  }
  .chip-row,
  .source-jumps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .source-jumps a {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface-raised);
    color: var(--text);
    font-size: var(--fs-small);
    padding: 0.25rem 0.65rem;
    text-decoration: none;
  }
  .source-jumps a:hover {
    border-color: var(--accent);
    color: var(--accent-hover);
  }

  .problems {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }
  .source-groups {
    display: grid;
    gap: var(--sp-12);
  }
  .source-group {
    scroll-margin-top: var(--sp-16);
  }
  .source-group[hidden],
  .problem[hidden] {
    display: none;
  }
  .problem {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface-raised);
    padding: var(--sp-8);
    scroll-margin-top: var(--sp-16);
  }

  /* Question text — verbatim, with blank-line-separated parts as paragraphs. */
  .problem__q p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text);
    margin: 0 0 var(--sp-4);
    white-space: pre-line;
  }
  .problem__q p:last-child {
    margin-bottom: 0;
  }

  /* Provenance line: source · context · back-link. */
  .problem__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2) var(--sp-3);
    margin: var(--sp-6) 0 0;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--hairline);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .problem__source {
    font-style: italic;
  }
  .problem__tag {
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 0.1em 0.5em;
  }
  .problem__src-link {
    margin-left: auto;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .problem__subtopics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-4) 0 0;
  }
  .chip {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.02em;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 0.15em 0.6em;
  }
  .chip--button {
    cursor: pointer;
    font-family: var(--font-body);
  }
  .chip--button:hover,
  .chip--button.is-active {
    border-color: var(--accent);
    color: var(--accent-hover);
  }

  .problem__solution {
    margin-top: var(--sp-6);
  }
  .problem__solution summary {
    cursor: pointer;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--accent);
  }
  .problem__solution p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text);
    margin: var(--sp-4) 0 0;
    white-space: pre-line;
  }

  .bank__back {
    margin-top: var(--sp-16);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--hairline);
    font-size: var(--fs-small);
  }
  .bank__empty {
    color: var(--text-muted);
  }
</style>

<script>
  const buttons = [...document.querySelectorAll('[data-chip-value]')];
  const problems = [...document.querySelectorAll('[data-problem]')];
  const groups = [...document.querySelectorAll('[data-source-group]')];
  const count = document.querySelector('[data-topic-count]');
  const empty = document.querySelector('[data-topic-empty]');
  let active = '';

  function tokens(value) {
    return String(value || '').split(/\s+/).filter(Boolean);
  }

  function setActive(value) {
    active = value;
    let visible = 0;

    for (const problem of problems) {
      const ok = !active || tokens(problem.dataset.subtopics).includes(active);
      problem.hidden = !ok;
      if (ok) visible += 1;
    }

    for (const group of groups) {
      group.hidden = !group.querySelector('[data-problem]:not([hidden])');
    }

    for (const button of buttons) {
      button.classList.toggle('is-active', button.dataset.chipValue === active);
    }

    if (count) count.textContent = `Showing ${visible} problem${visible === 1 ? '' : 's'}`;
    if (empty) empty.hidden = visible !== 0;
  }

  for (const button of buttons) {
    button.addEventListener('click', () => setActive(button.dataset.chipValue || ''));
  }
</script>
