---
// Topic page for Principles of Microeconomics. Renders one imported course post
// (src/content/courses/microeconomics/<slug>/post.md) in the marketing brand,
// with an in-page TOC, downloadable slides (when present), and prev/next paging.
//
// Publish gate: only `status: approved` topics route in the PRODUCTION build.
// In `astro dev` ALL topics route (draft preview) so Bryan can read in-progress
// posts locally — they never reach the public build. Mirrors how Starlight
// treats `draft:` pages (shown in dev, excluded from prod).
import { getCollection, render } from 'astro:content';
import MarketingLayout from '../../../layouts/MarketingLayout.astro';
import Eyebrow from '../../../components/marketing/Eyebrow.astro';
import DownloadCard from '../../../components/marketing/DownloadCard.astro';
import CTABand from '../../../components/marketing/CTABand.astro';

// NOTE: getStaticPaths() runs in its own isolated scope and cannot see
// module-level consts, so COURSE/topicOrder are declared inside it. The template
// below re-declares COURSE for its hrefs.
export async function getStaticPaths() {
  const COURSE = 'microeconomics';
  const previewDrafts = import.meta.env.DEV;
  // Order comes from the directory slug (t01, t03a, t03b…), which is
  // authoritative and always well-formed — NOT the `topic:` prose, whose
  // upstream label is inconsistent (T6/T10 still carry the old lowercase
  // bundled name, which the case-sensitive /T\d+/ missed → they sorted last).
  // The slug also encodes the a/b/c lecture split: t04a < t04b < t04c.
  const topicOrder = (slug: string, entry: any): number => {
    const m = slug.match(/^t(\d+)([a-z]?)/i);
    const num = m ? parseInt(m[1], 10) : 999;
    const part = m?.[2] ? m[2].toLowerCase().charCodeAt(0) - 96 : 0; // a=1,b=2,c=3
    return entry.data.order ?? num * 100 + part;
  };
  const isPublished = (e: any) =>
    previewDrafts || (e.data.status ?? '').toLowerCase() === 'approved';

  const ordered = (await getCollection('courses'))
    .filter((e) => e.id.split('/')[0] === COURSE)
    .filter(isPublished)
    .map((e) => ({ entry: e, slug: e.id.split('/')[1] }))
    .sort((a, b) => topicOrder(a.slug, a.entry) - topicOrder(b.slug, b.entry));

  const link = (x: { entry: any; slug: string }) => ({
    slug: x.slug,
    title: x.entry.data.title,
  });

  return ordered.map((cur, i) => ({
    params: { topic: cur.slug },
    props: {
      entry: cur.entry,
      lectureNum: i + 1, // sequential position in the published sequence
      prev: i > 0 ? link(ordered[i - 1]) : null,
      next: i < ordered.length - 1 ? link(ordered[i + 1]) : null,
    },
  }));
}

const COURSE = 'microeconomics'; // for the template hrefs (getStaticPaths has its own)
const { entry, prev, next, lectureNum } = Astro.props;
const data = entry.data;
const { Content, headings } = await render(entry);

// Eyebrow band: course name (drop the institutional "(FAU)") + sequential
// lecture number. We number lectures 1..N by published order rather than the
// upstream "T#" — several T-numbers span multiple lectures via a/b/c splits, so
// the shared "T3"/"T6" badge repeated and read as duplicate titles.
const courseLabel = (data.course ?? 'Principles of Microeconomics').replace(
  /\s*\(.*\)\s*$/,
  '',
);
const lectureLabel = lectureNum ? `Lecture ${lectureNum}` : '';

// In-page TOC from the post's ## claim headers. Collapses (hidden) on short
// posts. Astro auto-assigns slug ids to headings, so #slug anchors resolve.
const toc = headings.filter((h) => h.depth === 2);

// Meta description: frontmatter if present, else a ~155-char excerpt from the
// first real body paragraph (the source has no `description`).
function metaDescription(): string {
  if (data.description) return data.description;
  const para = (entry.body ?? '')
    .split(/\n\s*\n/)
    .map((s: string) => s.trim())
    .find(
      (s: string) =>
        s && !s.startsWith('#') && !s.startsWith('<') && !s.startsWith('!'),
    );
  if (!para) return `${data.title} — Principles of Microeconomics.`;
  const plain = para
    .replace(/[*_`>#]/g, '')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/\s+/g, ' ')
    .trim();
  return plain.length > 155
    ? plain.slice(0, 152).replace(/\s+\S*$/, '') + '…'
    : plain;
}

const isDraft = (data.status ?? '').toLowerCase() !== 'approved';
---
<MarketingLayout title={`${data.title} — Bryan Cutsinger`} description={metaDescription()}>
  <article class="topic">
    <div class="topic__layout">
      {
        toc.length > 1 && (
          <nav class="toc-sidebar" aria-label="On this page">
            <p class="toc__label">On this page</p>
            <ol class="toc__list">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="topic__main">
        <header class="topic__head">
          <Eyebrow text={lectureLabel ? `${courseLabel} · ${lectureLabel}` : courseLabel} />
          {
            isDraft && (
              <p class="topic__draft">
                Draft preview — not published. Visible only in local <code>dev</code>.
              </p>
            )
          }
        </header>

        <div class="prose">
          <Content />
        </div>

        {
          data.slides.length > 0 && (
            <section class="topic__slides">
              <h2 class="topic__slides-h">Slides</h2>
              <div class="topic__slides-grid">
                {data.slides.map((s: { label: string; file: string }) => (
                  <DownloadCard
                    title={s.label}
                    fileUrl={`/downloads/${s.file}`}
                    downloadLabel="Download the slides (PDF)"
                    requestLabel="Request the slides"
                  />
                ))}
              </div>
            </section>
          )
        }

        <nav class="pager" aria-label="Topics">
          <div class="pager__cell">
            {
              prev && (
                <a href={`/teaching/${COURSE}/${prev.slug}/`} class="pager__link">
                  <span class="pager__dir">← Previous</span>
                  <span class="pager__title">{prev.title}</span>
                </a>
              )
            }
          </div>
          <div class="pager__cell pager__cell--right">
            {
              next && (
                <a href={`/teaching/${COURSE}/${next.slug}/`} class="pager__link">
                  <span class="pager__dir">Next →</span>
                  <span class="pager__title">{next.title}</span>
                </a>
              )
            }
          </div>
        </nav>

        <p class="topic__back">
          <a href={`/teaching/${COURSE}/`}>← Back to the course</a>
        </p>
      </div>
    </div>
  </article>

  <CTABand
    heading="Questions about the course or its materials?"
    cta={{ label: 'Get in touch', href: '/contact/' }}
  />
</MarketingLayout>

<style>
  .topic {
    max-width: 64rem;
    margin-inline: auto;
    padding: var(--sp-16) var(--sp-6) var(--sp-24);
  }

  /* Two-column reading layout: sticky "On this page" sidebar (left) + the
     reading column. Collapses to a single centered reading column below 60rem
     and whenever a post is too short to warrant a TOC. */
  .topic__layout {
    display: grid;
    grid-template-columns: minmax(0, var(--reading));
    justify-content: center;
    gap: var(--sp-12);
    align-items: start;
  }
  .topic__main {
    min-width: 0;
  }
  @media (min-width: 60rem) {
    .topic__layout:has(> .toc-sidebar) {
      grid-template-columns: 13rem minmax(0, var(--reading));
    }
  }
  .topic__head {
    margin-bottom: var(--sp-8);
  }
  .topic__draft {
    margin: var(--sp-4) 0 0;
    padding: var(--sp-2) var(--sp-4);
    border-left: 3px solid var(--accent);
    background: var(--accent-tint);
    color: var(--text);
    font-size: var(--fs-small);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  /* On-page TOC — sticky left sidebar on wide viewports; hidden on narrow
     screens, where the reading column takes the full width. */
  .toc-sidebar {
    display: none;
  }
  @media (min-width: 60rem) {
    .toc-sidebar {
      display: block;
      position: sticky;
      top: var(--sp-16);
      align-self: start;
    }
  }
  .toc__label {
    margin: 0 0 var(--sp-2);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .toc__list {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: var(--sp-1);
    font-size: var(--fs-small);
  }
  .toc__list a {
    text-decoration: none;
  }
  .toc__list a:hover {
    text-decoration: underline;
  }

  /* ---- long-form prose (renders the imported Markdown body) ---------------- */
  .prose :global(h1) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-display-lg);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 var(--sp-8);
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-h2);
    line-height: 1.18;
    color: var(--ink);
    margin: var(--sp-16) 0 var(--sp-4);
    scroll-margin-top: var(--sp-16);
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-h3);
    color: var(--ink);
    margin: var(--sp-12) 0 var(--sp-4);
    scroll-margin-top: var(--sp-16);
  }
  .prose :global(p) {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text);
    margin: 0 0 var(--sp-6);
    max-width: none;
  }
  .prose :global(ul),
  .prose :global(ol) {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text);
    margin: 0 0 var(--sp-6);
    padding-left: 1.4rem;
  }
  .prose :global(li) {
    margin-bottom: var(--sp-2);
  }
  .prose :global(li::marker) {
    color: var(--text-muted);
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(strong) {
    font-weight: 650;
    color: var(--ink);
  }
  .prose :global(blockquote) {
    margin: var(--sp-8) 0;
    padding: var(--sp-2) var(--sp-6);
    border-left: 3px solid var(--accent);
    color: var(--text-muted);
    font-style: italic;
  }
  .prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 0.1em 0.35em;
  }
  .prose :global(pre) {
    background: var(--ink);
    color: var(--on-ink);
    padding: var(--sp-6);
    border-radius: var(--radius);
    overflow-x: auto;
    margin: 0 0 var(--sp-6);
  }
  .prose :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--hairline);
    margin: var(--sp-12) 0;
  }

  /* ---- teaching callouts (econ- design system) ---------------------------
     Four visually distinct devices so a definition, a retrieval prompt, a
     source quote, and the end summary never look alike. Referenced from posts
     via raw-HTML <aside class="econ-callout ..."> / <blockquote class="econ-quote">.
     Additive: leaves the base prose rules above untouched. */

  /* Lead paragraph (dek) — opt-in via <p class="econ-dek"> on the opener. */
  .prose :global(.econ-dek) {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--ink);
    margin: 0 0 var(--sp-6);
  }

  .prose :global(.econ-callout) {
    margin: var(--sp-8) 0;
    padding: var(--sp-4) var(--sp-6);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 1rem;
    line-height: 1.6;
  }
  .prose :global(.econ-callout__label) {
    margin: 0 0 var(--sp-3);
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .prose :global(.econ-callout p) {
    margin: 0 0 var(--sp-2);
  }
  .prose :global(.econ-callout p:last-child) {
    margin-bottom: 0;
  }

  /* Key-term definitions — white card, brass top-rule, Fraunces terms. */
  .prose :global(.econ-termset) {
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-top: 3px solid var(--accent);
  }
  .prose :global(.econ-term-list) {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
  }
  .prose :global(.econ-term-list > div) {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--sp-1) var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--hairline);
  }
  .prose :global(.econ-term-list > div:first-child) {
    padding-top: 0;
    border-top: 0;
  }
  .prose :global(.econ-term-list dt) {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
  }
  .prose :global(.econ-term-list dd) {
    margin: 0;
    color: var(--text-muted);
  }

  /* Definition — an emphasized single-term card. Brass top-rule and label like
     the termset, but the definition text itself is set a touch larger and
     medium-weight so it stands apart from the surrounding body prose. */
  .prose :global(.econ-def) {
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-top: 3px solid var(--accent);
  }
  .prose :global(.econ-def p:not(.econ-callout__label)) {
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.55;
    color: var(--ink);
  }

  /* Learning objectives — a top-of-post card. The lead <p> reads as intro text;
     the <ul>/<li> get comfortable padding and item spacing. Same card + label
     styling as the other callouts. */
  .prose :global(.econ-objectives) {
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-top: 3px solid var(--accent);
  }
  .prose :global(.econ-objectives ul) {
    margin: var(--sp-3) 0 0;
    padding-left: 1.4rem;
    display: grid;
    gap: var(--sp-2);
    font-size: 1rem;
    line-height: 1.6;
  }
  .prose :global(.econ-objectives li) {
    margin: 0;
  }

  /* Pause and check — tinted retrieval prompt with a brass "?" chip. */
  .prose :global(.econ-check) {
    display: grid;
    grid-template-columns: 2rem 1fr;
    column-gap: var(--sp-4);
    background: var(--accent-tint);
    border: 1px dashed var(--accent);
    border-left: 3px solid var(--accent);
  }
  .prose :global(.econ-check::before) {
    content: "?";
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: start;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
  }
  .prose :global(.econ-check > *) {
    grid-column: 2;
  }

  /* Source quote — reserved for real quotations (not instructional boxes). */
  .prose :global(blockquote.econ-quote) {
    margin: var(--sp-8) 0;
    padding: var(--sp-1) 0 var(--sp-1) var(--sp-6);
    border-left: 4px double var(--accent);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.5;
    font-style: normal;
  }
  .prose :global(blockquote.econ-quote p) {
    margin: 0;
    color: var(--ink);
    font-style: normal;
  }
  .prose :global(blockquote.econ-quote footer) {
    margin-top: var(--sp-3);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* End-of-post review — the single consolidated summary. */
  .prose :global(.econ-review) {
    margin: var(--sp-12) 0 var(--sp-8);
    padding: var(--sp-6);
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-top: 5px solid var(--ink);
    border-radius: var(--radius);
  }
  .prose :global(.econ-review > h2) {
    margin-top: 0;
  }
  .prose :global(.econ-review__section + .econ-review__section) {
    margin-top: var(--sp-6);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--hairline);
  }
  .prose :global(.econ-review__section > h3) {
    margin-top: 0;
  }

  /* Figure wrapper — hairline-framed embed with a real <figcaption>. */
  .prose :global(.econ-figure) {
    margin: var(--sp-8) 0 var(--sp-2);
  }
  .prose :global(.econ-figure figcaption) {
    margin-top: var(--sp-3);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--text-muted);
  }
  .prose :global(.econ-figure figcaption strong) {
    color: var(--ink);
  }

  /* Figures (SVGs served from /public): centered, hairline-framed, with the
     immediately-following italic paragraph styled as a caption (best-effort). */
  .prose :global(img) {
    display: block;
    margin: var(--sp-8) auto var(--sp-2);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface-raised);
    padding: var(--sp-4);
  }
  /* Caption heuristic: an all-italic paragraph *immediately after an image*
     renders as a centered caption. Scoped to `p:has(> img) + p` so it never
     catches an inline first-use term whose paragraph happens to contain a
     single <em> (`:only-child` ignores text nodes, so the bare selector
     over-matched and center-blocked ordinary italic terms). Figure embeds now
     use <figure class="econ-figure"><figcaption>, which this leaves untouched. */
  .prose :global(p:has(> img) + p > em:only-child) {
    display: block;
    text-align: center;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* GFM tables (a real requirement for later topics) — minimal hairline style,
     matching the brand's no-zebra table pattern. */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 var(--sp-8);
    font-size: var(--fs-small);
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: var(--sp-2) var(--sp-3);
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .prose :global(thead th) {
    border-bottom: 2px solid var(--ink);
    font-weight: 600;
  }

  /* ---- slides ------------------------------------------------------------- */
  .topic__slides {
    max-width: var(--reading);
    margin: var(--sp-16) auto 0;
  }
  .topic__slides-h {
    font-size: var(--fs-h3);
    margin: 0 0 var(--sp-4);
  }
  .topic__slides-grid {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  /* ---- prev/next pager + back link ---------------------------------------- */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-6);
    margin-top: var(--sp-16);
    padding-top: var(--sp-8);
    border-top: 1px solid var(--hairline);
  }
  .pager__cell--right {
    text-align: right;
  }
  .pager__link {
    display: inline-flex;
    flex-direction: column;
    gap: var(--sp-1);
    text-decoration: none;
    color: var(--ink);
  }
  .pager__link:hover .pager__title {
    color: var(--accent);
  }
  .pager__dir {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .pager__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .topic__back {
    margin-top: var(--sp-8);
    font-size: var(--fs-small);
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager__cell--right {
      text-align: left;
    }
  }
</style>
