---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHead from '../components/marketing/PageHead.astro';
import Section from '../components/marketing/Section.astro';
import BookingForm from '../components/marketing/BookingForm.astro';
---
<MarketingLayout
  title="Contact — Bryan Cutsinger"
  description="Get in touch with Bryan Cutsinger about speaking engagements, media, or academic inquiries."
>
  <PageHead
    edition="Response within a few days"
    headline="Get in touch."
    lede="Use the form below for speaking, media, academic, and other professional inquiries."
  />

  <!-- All inquiries use one direct form; no email address is exposed in HTML. -->
  <Section variant="surface" id="book">
    <div class="head">
      <h2>Send an inquiry.</h2>
      <p class="lede">
        Tell me what you have in mind. For time-sensitive media requests,
        include your deadline and topic in the message.
      </p>
    </div>
    <BookingForm subject="Website inquiry - bryancutsinger.com" />
  </Section>
</MarketingLayout>

<style>
  .head {
    border-top: 3px double var(--structure);
    padding-top: var(--sp-6);
    margin-bottom: var(--sp-8);
  }
  .head .lede { margin-top: var(--sp-3); }
</style>
