---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHead from '../components/marketing/PageHead.astro';
import Section from '../components/marketing/Section.astro';
import BookingForm from '../components/marketing/BookingForm.astro';

const generalEmail = 'bcutsinger@fau.edu';
const bookingEmail = 'bryanpcutsinger@gmail.com';
---
<MarketingLayout
  title="Contact — Bryan Cutsinger"
  description="Get in touch with Bryan Cutsinger about speaking engagements, media, or academic inquiries."
>
  <PageHead
    kicker="Contact"
    edition="Response within a few days"
    headline="Get in touch."
    lede="Speaking inquiries get a personal reply. For media and academic matters, email is best."
  />

  <!-- Speaking inquiries (primary) -->
  <Section variant="surface" id="book">
    <div class="head">
      <p class="kicker">Speaking inquiries</p>
      <h2>Invite Bryan to speak.</h2>
      <p class="lede">
        Tell me about your event below — the more detail, the faster I can respond.
      </p>
    </div>
    <BookingForm email={bookingEmail} />
  </Section>

  <!-- General / media -->
  <Section variant="raised" width="reading">
    <div class="head">
      <p class="kicker">Media & academic</p>
      <h2>Everything else.</h2>
    </div>
    <p>
      For interviews, commentary requests, academic correspondence, or anything
      that isn't a speaking inquiry, email me directly:
    </p>
    <p class="contact-email">
      <a href={`mailto:${generalEmail}`}>{generalEmail}</a>
    </p>
    <p class="contact-note">
      For time-sensitive media requests, include your deadline and topic in the
      subject line.
    </p>
  </Section>
</MarketingLayout>

<style>
  .head { margin-bottom: var(--sp-8); }
  .head .lede { margin-top: var(--sp-3); }
  .contact-email { font-family: var(--font-display); font-size: var(--fs-h3); }
  .contact-note { color: var(--muted); font-size: var(--fs-small); }
</style>
