---
import { Image } from 'astro:assets';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Section from '../components/marketing/Section.astro';
import Button from '../components/marketing/Button.astro';
import DatedList from '../components/marketing/DatedList.astro';

import headshot from '../assets/bryan-cutsinger.png';
import topicsData from '../data/topics.json';
import writingData from '../data/writing.json';
import pubData from '../data/publications.json';

// Signature talks — first three real topics, framed for the front door.
const talks = topicsData.topics.slice(0, 3);

// Recent work — a single self-updating feed that MERGES two auto-generated
// sources, so the homepage reflects Bryan's latest across writing AND research:
//   • columns/op-eds  → src/data/writing.json  (RSS feeds; month-dated)
//   • publications    → src/data/publications.json  (generated from the CV; year-dated)
// Undated working papers are NOT date-sortable, so we never invent a date for
// them — they're surfaced as a count-link to /research/ below the list instead.
const columns = (writingData.essays ?? []).map((e) => ({
  sort: e.isoDate,
  date: e.date,
  title: e.title,
  meta: e.outlet ? `${e.outlet}${e.kind ? ` · ${e.kind}` : ''}` : e.kind,
  href: e.url || undefined,
  external: !!e.url,
}));

const pubRows = [
  ...(pubData.worksInPress ?? []).map((p) => ({ ...p, kindLabel: 'Book · in press' })),
  ...(pubData.articles ?? []).map((p) => ({ ...p, kindLabel: `${p.venue} · Article` })),
  ...(pubData.bookChapters ?? []).map((p) => ({ ...p, kindLabel: 'Book chapter' })),
]
  .filter((p) => p.year)
  .map((p) => ({
    sort: `${p.year}-06-30`, // year-only → mid-year proxy for ordering only (never shown)
    date: p.year,
    title: p.title,
    meta: p.kindLabel,
    href: p.url || undefined,
    external: !!p.url,
  }));

const recent = [...columns, ...pubRows]
  .sort((a, b) => (a.sort < b.sort ? 1 : a.sort > b.sort ? -1 : 0))
  .slice(0, 5)
  .map(({ sort, ...item }) => item);

// Only items the CV actually labels "Working paper" — NOT the under-review /
// R&R manuscripts the CV groups into the same array (those are submitted to
// journals, a different status, and are shown on the Research page).
const workingPaperCount = (pubData.workingPapers ?? []).filter(
  (p) => p.status === 'Working paper'
).length;
---
<MarketingLayout
  title="Bryan Cutsinger — Economist, Speaker, Writer"
  description="Bryan Cutsinger is an economist at Florida Atlantic University who explains the economics behind the headlines — money, inflation, and public policy — in National Review, The Hill, and The Washington Examiner, and to live audiences."
>
  <!-- Masthead: the outward front door -->
  <section class="mast">
    <div class="mast__inner">
      <div class="mast__copy">
        <p class="kicker">Economist · Speaker · Writer</p>
        <h1 class="mast__headline">
          Making sense of the economics <em>behind the headlines</em>.
        </h1>
        <p class="mast__sub">
          I'm Bryan Cutsinger, an economist at Florida Atlantic University, where I
          direct the graduate program in economics. My research on monetary theory,
          economic history, and political economy appears in journals like the
          <em>European Economic Review</em> and <em>Public Choice</em>, where I'm
          also an associate editor. I'm acting director of AIER's Sound Money
          Project and write the monthly <em>Price Theory</em> column at Econlib and
          commentary for <em>National Review</em>, <em>The Hill</em>, and
          <em>City Journal</em> — connecting the forces behind the headlines to the
          ideas that explain them.
        </p>
        <div class="mast__cta">
          <Button href="/speaking/" variant="primary">Invite me to speak</Button>
          <Button href="/writing/" variant="secondary">Read my writing</Button>
        </div>
      </div>
      <figure class="mast__portrait">
        <Image
          src={headshot}
          alt="Bryan Cutsinger"
          width={440}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- Signature talks -->
  <Section variant="sunk">
    <div class="head">
      <p class="kicker">What I speak about</p>
      <h2>Talks your audience can use.</h2>
      <p class="lede">
        Research-backed keynotes and lectures, shaped to the host and occasion.
        A few of the topics I'm asked for most.
      </p>
    </div>
    <ol class="talks">
      {
        talks.map((t) => (
          <li class="talk">
            <p class="talk__meta label label--accent">{t.format} · {t.audience}</p>
            <h3 class="talk__title">{t.title}</h3>
            <p class="talk__dek">{t.description}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Invite band (outward speaker push + fee signal) -->
  <Section variant="ink">
    <div class="invite">
      <div class="invite__copy">
        <p class="kicker">Booking</p>
        <h2>Bring serious economics to your audience.</h2>
        <p class="invite__sub">
          Keynotes, lectures, and panels for universities, conferences,
          associations, and professional audiences. Tell me about your event and
          I'll get back to you personally.
        </p>
      </div>
      <div class="invite__aside">
        <p class="invite__fee">
          <span class="label">Fees</span>
          Fee range and availability on request — honorarium and workshop rates on
          inquiry.
        </p>
        <Button href="/speaking/" variant="on-ink">Check availability</Button>
      </div>
    </div>
  </Section>

  <!-- Recent -->
  <Section variant="sunk">
    <div class="head head--row">
      <div>
        <p class="kicker">Lately</p>
        <h2>Recent work.</h2>
      </div>
    </div>
    <DatedList items={recent} />
    <p class="recent-more">
      <a href="/writing/" class="label label--accent">See all writing →</a>
      {workingPaperCount > 0 && (
        <a href="/research/" class="label label--accent">
          {workingPaperCount} working papers →
        </a>
      )}
    </p>
  </Section>
</MarketingLayout>

<style>
  /* --- masthead --- */
  .mast {
    padding-top: calc(var(--header-h) + var(--sp-16));
    padding-bottom: var(--section-y);
    background: var(--paper);
  }
  .mast__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--sp-6);
    display: grid;
    grid-template-columns: 1.5fr 0.9fr;
    gap: var(--sp-16);
    align-items: center;
  }
  .mast__headline {
    font-size: var(--fs-mast);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 var(--sp-6);
    max-width: 15ch;
  }
  .mast__headline em { font-style: italic; color: var(--accent); }
  .mast__sub {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--muted);
    max-width: 52ch;
    margin: 0 0 var(--sp-8);
  }
  .mast__sub em { font-style: italic; color: var(--ink); }
  .mast__cta { display: flex; gap: var(--sp-3); flex-wrap: wrap; }
  .mast__portrait {
    margin: 0;
    justify-self: end;
    max-width: 320px;
  }
  .mast__portrait img {
    border-radius: var(--radius-lg);
    filter: grayscale(0.15);
  }

  /* --- section head --- */
  .head { margin-bottom: var(--sp-8); }
  .head h2 { max-width: 20ch; }
  .head .lede { margin-top: var(--sp-3); }

  /* recent → see-all links */
  .recent-more {
    margin: var(--sp-8) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-8);
  }
  .recent-more a { text-decoration: none; }
  .recent-more a:hover { text-decoration: underline; }

  /* --- signature talks --- */
  .talks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-8);
    border-top: 1px solid var(--hairline);
    padding-top: var(--sp-8);
  }
  .talk__meta { display: block; margin-bottom: var(--sp-3); }
  .talk__title { font-size: var(--fs-h3); margin: 0 0 var(--sp-3); }
  .talk__dek { margin: 0; color: var(--muted); font-size: 0.98rem; }

  /* --- invite band --- */
  .invite {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: var(--sp-12);
    align-items: center;
  }
  .invite__sub { color: var(--on-ink-muted); font-size: var(--fs-lead); line-height: 1.5; margin: 0; max-width: 48ch; }
  .invite__aside { display: flex; flex-direction: column; gap: var(--sp-6); align-items: flex-start; }
  .invite__fee { color: var(--on-ink-muted); margin: 0; font-size: 0.95rem; }
  .invite__fee .label { display: block; color: var(--accent-on-ink); margin-bottom: var(--sp-2); }

  /* --- responsive --- */
  @media (max-width: 900px) {
    .mast__inner { grid-template-columns: 1fr; gap: var(--sp-8); }
    .mast__portrait { order: -1; justify-self: start; max-width: 200px; }
    .talks { grid-template-columns: 1fr; gap: var(--sp-6); }
    .invite { grid-template-columns: 1fr; gap: var(--sp-8); }
  }
</style>
