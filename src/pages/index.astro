---
import { Image } from 'astro:assets';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Section from '../components/marketing/Section.astro';
import Button from '../components/marketing/Button.astro';
import DatedList from '../components/marketing/DatedList.astro';

import headshot from '../assets/bryan-cutsinger.png';
import topicsData from '../data/topics.json';
import writingData from '../data/writing.json';
import pubData from '../data/publications.json';

// Signature talks — first three real topics, framed for the front door.
const talks = topicsData.topics.slice(0, 3);

// Recent work — a single self-updating feed that MERGES two auto-generated
// sources, so the homepage reflects Bryan's latest across writing AND research:
//   • columns/op-eds  → src/data/writing.json  (RSS feeds; month-dated)
//   • publications    → src/data/publications.json  (generated from the CV; year-dated)
// Undated working papers are NOT date-sortable, so we never invent a date for
// them — they're surfaced as a count-link to /research/ below the list instead.
const columns = (writingData.essays ?? []).map((e) => ({
  sort: e.isoDate,
  date: e.date,
  title: e.title,
  meta: e.outlet ? `${e.outlet}${e.kind ? ` · ${e.kind}` : ''}` : e.kind,
  href: e.url || undefined,
  external: !!e.url,
}));

const pubRows = [
  ...(pubData.worksInPress ?? []).map((p) => ({ ...p, kindLabel: 'Book · in press' })),
  ...(pubData.articles ?? []).map((p) => ({ ...p, kindLabel: `${p.venue} · Article` })),
  ...(pubData.bookChapters ?? []).map((p) => ({ ...p, kindLabel: 'Book chapter' })),
]
  .filter((p) => p.year)
  .map((p) => ({
    sort: `${p.year}-06-30`, // year-only → mid-year proxy for ordering only (never shown)
    date: p.year,
    title: p.title,
    meta: p.kindLabel,
    href: p.url || undefined,
    external: !!p.url,
  }));

const recent = [...columns, ...pubRows]
  .sort((a, b) => (a.sort < b.sort ? 1 : a.sort > b.sort ? -1 : 0))
  .slice(0, 5)
  .map(({ sort, ...item }) => item);

// Only items the CV actually labels "Working paper" — NOT the under-review /
// R&R manuscripts the CV groups into the same array (those are submitted to
// journals, a different status, and are shown on the Research page).
const workingPaperCount = (pubData.workingPapers ?? []).filter(
  (p) => p.status === 'Working paper'
).length;
---
<MarketingLayout
  title="Bryan Cutsinger — Economist, Speaker, Writer"
  description="Bryan Cutsinger is a Florida Atlantic University economist and speaker on the U.S. economic outlook, South Florida's regional economy, and monetary policy."
>
  <!-- Masthead: the briefing opener on the navy field. The sticky header sits
       on the same field, so the two read as one block. One dominant action. -->
  <section class="mast">
    <div class="mast__inner">
      <div class="mast__copy">
        <h1 class="mast__headline">
          Making sense of the economics <em>behind the headlines</em>.
        </h1>
        <p class="mast__sub">
          I'm an economist at Florida Atlantic University, where I direct the
          graduate program in economics. I speak and write about money,
          inflation, and the economic outlook for business, policy, and
          university audiences.
        </p>
        <div class="mast__cta">
          <Button href="/speaking/" variant="action-inverse">Invite me to speak</Button>
          <a href="/writing/" class="mast__quiet">Read my writing →</a>
        </div>
      </div>
      <figure class="mast__portrait">
        <Image
          src={headshot}
          alt="Bryan Cutsinger"
          width={440}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- Signature talks -->
  <Section variant="surface">
    <div class="head">
      <h2>Talks your audience can use.</h2>
      <p class="lede">
        Research-backed keynotes and lectures, shaped to the host and occasion.
        A few of the topics I'm asked for most.
      </p>
    </div>
    <ol class="talks">
      {
        talks.map((t) => (
          <li class="talk">
            <p class="talk__meta label">{t.format}</p>
            <h3 class="talk__title">{t.title}</h3>
            <p class="talk__dek">{t.description}</p>
            {t.href && (
              <p class="talk__source">
                <a href={t.href} rel="noopener">{t.linkLabel} ↗</a>
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Booking band -->
  <Section variant="ink">
    <div class="invite">
      <div class="invite__copy">
        <h2>Bring serious economics to your audience.</h2>
        <p class="invite__sub">
          Keynotes, lectures, and panels for universities, conferences,
          associations, and professional audiences. Tell me about your event and
          I'll get back to you personally.
        </p>
      </div>
      <div class="invite__card">
        <p class="label">Engagements</p>
        <p class="invite__details">
          Available for local, national, and virtual keynotes, briefings,
          panels, workshops, and university visits.
        </p>
        <Button href="/speaking/" variant="action">Check availability</Button>
      </div>
    </div>
  </Section>

  <!-- Recent: the ruled dated record -->
  <Section variant="sunk">
    <div class="head head--flush">
      <h2>Recent work.</h2>
    </div>
    <DatedList items={recent} />
    <p class="recent-more">
      <a href="/writing/">See all writing →</a>
      {workingPaperCount > 0 && (
        <a href="/research/">{workingPaperCount} working papers →</a>
      )}
    </p>
  </Section>
</MarketingLayout>

<style>
  /* --- masthead: the navy field --- */
  .mast {
    background: var(--field);
    color: var(--on-field);
    padding-top: var(--sp-16);
    padding-bottom: var(--section-y);
    border-bottom: 4px solid var(--field-edge);
  }
  .mast__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--sp-6);
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--sp-16);
    align-items: center;
  }
  .mast__headline {
    font-size: var(--fs-mast);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.015em;
    margin: 0 0 var(--sp-4);
    max-width: 17ch;
    color: var(--on-field);
  }
  .mast__headline em { font-style: italic; font-weight: 500; }
  .mast__sub {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--on-field-muted);
    max-width: 46ch;
    margin: 0 0 var(--sp-6);
  }
  .mast__cta {
    display: flex;
    gap: var(--sp-6);
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: var(--sp-8);
  }
  .mast__quiet {
    font-family: var(--font-label);
    font-size: 0.84rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--on-field-muted);
  }
  .mast__quiet:hover { color: var(--on-field); }

  .mast__portrait {
    margin: 0;
    justify-self: end;
    width: min(100%, 400px);
  }
  .mast__portrait img {
    border-radius: var(--radius);
    border: 1px solid rgba(236, 233, 226, 0.3);
    padding: 6px;
    background: var(--card);
  }

  /* the one orchestrated moment: a quiet rise on page load (hero only) */
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  .mast__headline { animation: rise 0.55s cubic-bezier(0.2, 0.7, 0.3, 1) 0.05s backwards; }
  .mast__sub { animation: rise 0.55s cubic-bezier(0.2, 0.7, 0.3, 1) 0.13s backwards; }
  .mast__cta { animation: rise 0.55s cubic-bezier(0.2, 0.7, 0.3, 1) 0.21s backwards; }
  .mast__portrait { animation: rise 0.65s cubic-bezier(0.2, 0.7, 0.3, 1) 0.16s backwards; }

  /* --- section heads: a double structural rule, no eyebrow --- */
  .head {
    border-top: 3px double var(--structure);
    padding-top: var(--sp-6);
    margin-bottom: var(--sp-8);
  }
  .head--flush { border-top: 0; padding-top: 0; }
  .head h2 { max-width: 26ch; margin-bottom: var(--sp-2); }
  .head .lede { margin: 0; }

  /* --- signature talks --- */
  .talks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 var(--sp-8);
  }
  .talk + .talk {
    border-left: 1px solid var(--structure);
    padding-left: var(--sp-8);
  }
  .talk__meta { display: block; margin-bottom: var(--sp-3); }
  .talk__title { font-size: var(--fs-h3); margin: 0 0 var(--sp-3); }
  .talk__dek { margin: 0; color: var(--text-muted); font-size: 0.97rem; }
  .talk__source { margin: var(--sp-3) 0 0; font-family: var(--font-label); font-size: 0.82rem; }

  /* --- booking band --- */
  .invite {
    display: grid;
    grid-template-columns: 1.45fr 0.85fr;
    gap: var(--sp-12);
    align-items: center;
  }
  .invite__sub {
    color: var(--on-field-muted);
    font-size: var(--fs-lead);
    line-height: 1.5;
    margin: 0;
    max-width: 46ch;
  }
  .invite__card {
    background: var(--card);
    color: var(--text);
    border-radius: var(--radius);
    padding: var(--sp-6) var(--sp-6) var(--sp-8);
  }
  .invite__card .label { display: block; margin-bottom: var(--sp-2); }
  .invite__details {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: var(--sp-6);
  }

  /* --- recent → see-all links --- */
  .recent-more {
    margin: var(--sp-8) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-8);
  }
  .recent-more a {
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .recent-more a:hover { text-decoration: underline; }

  /* --- responsive --- */
  @media (max-width: 900px) {
    .mast__inner { grid-template-columns: 1fr; gap: var(--sp-8); }
    .mast__portrait { justify-self: start; width: min(100%, 300px); }
    .talks { grid-template-columns: 1fr; gap: var(--sp-6); }
    .talk + .talk {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--structure);
      padding-top: var(--sp-6);
    }
    .invite { grid-template-columns: 1fr; gap: var(--sp-8); }
  }
</style>
