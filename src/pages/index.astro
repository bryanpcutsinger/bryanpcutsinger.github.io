---
import { Image } from 'astro:assets';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Section from '../components/marketing/Section.astro';
import Button from '../components/marketing/Button.astro';
import DatedList from '../components/marketing/DatedList.astro';
import EmailCapture from '../components/marketing/EmailCapture.astro';

import headshot from '../assets/bryan-cutsinger.png';
import topicsData from '../data/topics.json';

// Signature talks — first three real topics, framed for the front door.
const talks = topicsData.topics.slice(0, 3);

// Featured-in outlets (verified; National Review, The Hill, Washington Examiner,
// RealClearEducation — WSJ deliberately excluded, it was a letter to the editor).
const outlets = [
  'National Review',
  'The Hill',
  'The Washington Examiner',
  'RealClearEducation',
];

// Recent — hand-curated literals (no cross-collection foreign keys). PLACEHOLDER
// dates/titles until Bryan supplies real recent essays/talks; marked as such.
const recent = [
  {
    date: '20XX',
    title: '[PLACEHOLDER] Recent essay or op-ed title',
    meta: 'Commentary',
    placeholder: true,
  },
  {
    date: '20XX',
    title: '[PLACEHOLDER] Recent talk or appearance',
    meta: 'Speaking',
    placeholder: true,
  },
  {
    date: '20XX',
    title: '[PLACEHOLDER] Recent working paper',
    meta: 'Research',
    placeholder: true,
  },
];

// Departments router.
const depts = [
  { title: 'Speaking', href: '/speaking/', dek: 'Keynotes and lectures on money, inflation, and public policy.' },
  { title: 'Writing', href: '/writing/', dek: 'Essays and commentary for National Review, The Hill, and beyond.' },
  { title: 'Research', href: '/research/', dek: 'Monetary theory and economic history, in the journals.' },
  { title: 'Teaching', href: '/teaching/', dek: 'Micro-economic principles and a price-theory problem bank.' },
];
---
<MarketingLayout
  title="Bryan Cutsinger — Economist, Speaker, Writer"
  description="Bryan Cutsinger is a monetary economist at Florida Atlantic University who makes the public case for sound money — in National Review and The Hill, and to audiences who want money, inflation, and public policy explained clearly."
>
  <!-- Masthead: the outward front door -->
  <section class="mast">
    <div class="mast__inner">
      <div class="mast__copy">
        <p class="kicker">Economist · Speaker · Writer</p>
        <h1 class="mast__headline">
          Making the public case for <em>sound money</em>.
        </h1>
        <p class="mast__sub">
          I'm Bryan Cutsinger, a monetary economist at Florida Atlantic
          University. I write for <em>National Review</em> and <em>The Hill</em>,
          direct the AIER Sound Money Project, and speak to audiences who want the
          forces behind money, inflation, and public policy explained clearly.
        </p>
        <div class="mast__cta">
          <Button href="/speaking/" variant="primary">Invite me to speak</Button>
          <Button href="/writing/" variant="secondary">Read my writing</Button>
        </div>
      </div>
      <figure class="mast__portrait">
        <Image
          src={headshot}
          alt="Bryan Cutsinger"
          width={440}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- Proof strip -->
  <Section variant="raised">
    <div class="proof">
      <p class="proof__label label">Featured in</p>
      <ul class="proof__outlets">
        {outlets.map((o) => <li>{o}</li>)}
      </ul>
      <p class="proof__creds">
        Interim Director, AIER Sound Money Project &nbsp;·&nbsp; Associate Editor,
        <em>Public Choice</em> &nbsp;·&nbsp; Florida Atlantic University
      </p>
    </div>
  </Section>

  <!-- Signature talks -->
  <Section variant="surface">
    <div class="head">
      <p class="kicker">What I speak about</p>
      <h2>Talks your audience can use.</h2>
      <p class="lede">
        Research-backed keynotes and lectures, shaped to the host and occasion.
        A few of the topics I'm asked for most.
      </p>
    </div>
    <ol class="talks">
      {
        talks.map((t) => (
          <li class="talk">
            <p class="talk__meta label label--accent">{t.format} · {t.audience}</p>
            <h3 class="talk__title">{t.title}</h3>
            <p class="talk__dek">{t.description}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Invite band (outward speaker push + fee signal) -->
  <Section variant="ink">
    <div class="invite">
      <div class="invite__copy">
        <p class="kicker">Booking</p>
        <h2>Bring serious economics to your audience.</h2>
        <p class="invite__sub">
          Keynotes, lectures, and panels for universities, conferences,
          associations, and professional audiences. Tell me about your event and
          I'll get back to you personally.
        </p>
      </div>
      <div class="invite__aside">
        <p class="invite__fee">
          <span class="label">Fees</span>
          Fee range and availability on request — honorarium and workshop rates on
          inquiry.
        </p>
        <Button href="/speaking/" variant="on-ink">Check availability</Button>
      </div>
    </div>
  </Section>

  <!-- Claude Code guide hook -->
  <Section variant="surface">
    <a class="guide" href="/ai/">
      <div class="guide__body">
        <p class="kicker">For economists</p>
        <h2 class="guide__title">A beginner's guide to Claude Code, for economists.</h2>
        <p class="guide__dek">
          A plain-language, Mac-friendly guide to getting started with AI coding
          tools — written for academic economists new to the command line, with
          examples from teaching and research.
        </p>
        <span class="guide__cta label label--accent">Read the guide →</span>
      </div>
    </a>
  </Section>

  <!-- Recent -->
  <Section variant="surface">
    <div class="head head--row">
      <div>
        <p class="kicker">Lately</p>
        <h2>Recent work.</h2>
      </div>
    </div>
    <DatedList items={recent} />
  </Section>

  <!-- Email capture -->
  <Section variant="surface">
    <EmailCapture />
  </Section>

  <!-- Departments router -->
  <Section variant="raised">
    <div class="head">
      <p class="kicker">Explore</p>
      <h2>Where to go next.</h2>
    </div>
    <ul class="depts">
      {
        depts.map((d) => (
          <li>
            <a class="dept" href={d.href}>
              <span class="dept__title">{d.title}</span>
              <span class="dept__dek">{d.dek}</span>
              <span class="dept__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</MarketingLayout>

<style>
  /* --- masthead --- */
  .mast {
    padding-top: calc(var(--header-h) + var(--sp-16));
    padding-bottom: var(--section-y);
    background: var(--paper);
  }
  .mast__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--sp-6);
    display: grid;
    grid-template-columns: 1.5fr 0.9fr;
    gap: var(--sp-16);
    align-items: center;
  }
  .mast__headline {
    font-size: var(--fs-mast);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 var(--sp-6);
    max-width: 15ch;
  }
  .mast__headline em { font-style: italic; color: var(--accent); }
  .mast__sub {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--muted);
    max-width: 52ch;
    margin: 0 0 var(--sp-8);
  }
  .mast__sub em { font-style: italic; color: var(--ink); }
  .mast__cta { display: flex; gap: var(--sp-3); flex-wrap: wrap; }
  .mast__portrait {
    margin: 0;
    justify-self: end;
    max-width: 320px;
  }
  .mast__portrait img {
    border-radius: var(--radius-lg);
    filter: grayscale(0.15);
  }

  /* --- section head --- */
  .head { margin-bottom: var(--sp-8); }
  .head h2 { max-width: 20ch; }
  .head .lede { margin-top: var(--sp-3); }

  /* --- proof --- */
  .proof { text-align: center; }
  .proof__label { display: block; margin-bottom: var(--sp-4); }
  .proof__outlets {
    list-style: none;
    margin: 0 0 var(--sp-6);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-4) var(--sp-8);
  }
  .proof__outlets li {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.9rem + 0.9vw, 1.5rem);
    color: var(--ink);
  }
  .proof__creds { color: var(--muted); font-size: 0.95rem; max-width: none; margin: 0; }
  .proof__creds em { font-style: italic; }

  /* --- signature talks --- */
  .talks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-8);
    border-top: 1px solid var(--hairline);
    padding-top: var(--sp-8);
  }
  .talk__meta { display: block; margin-bottom: var(--sp-3); }
  .talk__title { font-size: var(--fs-h3); margin: 0 0 var(--sp-3); }
  .talk__dek { margin: 0; color: var(--muted); font-size: 0.98rem; }

  /* --- invite band --- */
  .invite {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: var(--sp-12);
    align-items: center;
  }
  .invite__sub { color: var(--on-ink-muted); font-size: var(--fs-lead); line-height: 1.5; margin: 0; max-width: 48ch; }
  .invite__aside { display: flex; flex-direction: column; gap: var(--sp-6); align-items: flex-start; }
  .invite__fee { color: var(--on-ink-muted); margin: 0; font-size: 0.95rem; }
  .invite__fee .label { display: block; color: var(--accent-on-ink); margin-bottom: var(--sp-2); }

  /* --- guide hook --- */
  .guide {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-lg);
    padding: clamp(var(--sp-8), 4vw, var(--sp-16));
    background: var(--paper-raised);
    transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .guide:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .guide__title { max-width: 22ch; margin: 0 0 var(--sp-3); }
  .guide__dek { color: var(--muted); max-width: 60ch; margin: 0 0 var(--sp-4); }
  .guide__cta { display: inline-block; }

  /* --- departments --- */
  .depts {
    list-style: none; margin: 0; padding: 0;
    border-top: 1px solid var(--hairline);
  }
  .depts li { border-bottom: 1px solid var(--hairline); }
  .dept {
    display: grid;
    grid-template-columns: 12rem 1fr auto;
    align-items: baseline;
    gap: var(--sp-6);
    padding: var(--sp-6) 0;
    text-decoration: none;
    color: var(--ink);
  }
  .dept__title { font-family: var(--font-display); font-size: 1.4rem; }
  .dept__dek { color: var(--muted); }
  .dept__arrow { color: var(--muted); font-size: 1.2rem; transition: transform 0.18s ease, color 0.18s ease; }
  .dept:hover { background: color-mix(in srgb, var(--accent) 4%, transparent); }
  .dept:hover .dept__title { color: var(--accent); }
  .dept:hover .dept__arrow { color: var(--accent); transform: translateX(4px); }

  /* --- responsive --- */
  @media (max-width: 900px) {
    .mast__inner { grid-template-columns: 1fr; gap: var(--sp-8); }
    .mast__portrait { order: -1; justify-self: start; max-width: 200px; }
    .talks { grid-template-columns: 1fr; gap: var(--sp-6); }
    .invite { grid-template-columns: 1fr; gap: var(--sp-8); }
    .dept { grid-template-columns: 1fr auto; }
    .dept__dek { grid-column: 1 / -1; }
  }
</style>
