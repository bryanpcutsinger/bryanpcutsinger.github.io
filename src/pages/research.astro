---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHead from '../components/marketing/PageHead.astro';
import Section from '../components/marketing/Section.astro';
import CitationList from '../components/marketing/CitationList.astro';
import DownloadCard from '../components/marketing/DownloadCard.astro';
import CloseBand from '../components/marketing/CloseBand.astro';
import pubs from '../data/publications.json';

// Map the forgiving JSON to CitationList entries. A link renders only for real
// (non-placeholder) rows with a URL — scaffolds never show an invented DOI.
const toEntries = (rows: any[]) =>
  rows.map((r) => ({
    year: r.year,
    authors: r.authors,
    title: r.title,
    venue: r.venue,
    detail: r.status,
    href: !r.placeholder && r.url ? r.url : undefined,
    links: !r.placeholder && r.url ? [{ label: 'DOI', href: r.url }] : undefined,
    placeholder: r.placeholder,
  }));

const worksInPress = toEntries(pubs.worksInPress ?? []);
const articles = toEntries(pubs.articles ?? []);
const bookChapters = toEntries(pubs.bookChapters ?? []);
const workingPapers = toEntries(pubs.workingPapers ?? []);

// Section backgrounds alternate surface/raised across ALL rendered sections. Kept
// data-driven (not hardcoded) so the conditionally-rendered Book chapters / Books
// sections can be empty as publications.json changes without breaking the rhythm.
const sectionOrder = [
  'cv',
  'articles',
  ...(bookChapters.length > 0 ? ['chapters'] : []),
  ...(worksInPress.length > 0 ? ['books'] : []),
  'working',
];
const variantOf = (key: string) =>
  sectionOrder.indexOf(key) % 2 === 0 ? 'surface' : 'raised';
---
<MarketingLayout
  title="Research — Bryan Cutsinger"
  description="Research by Bryan Cutsinger in monetary theory, economic history, and public choice — peer-reviewed articles, working papers, and current projects."
>
  <PageHead
    kicker="Research"
    headline="Money, institutions, and the incentives behind policy."
    lede="My research sits at the intersection of monetary economics and economic history, with a recurring focus on seigniorage — the revenue governments raise by creating money — and the public-choice incentives that shape monetary institutions. My current work takes up the credibility of redeemable paper money, whether deflation's effects depend on its source, and the political economy of central banking, alongside a book with Alexander Salter on money and fiscal policy under contract for 2027."
  >
    <Fragment slot="headline">
      Money, institutions, and the <em>incentives</em> behind policy.
    </Fragment>
  </PageHead>

  <!-- CV (promoted from the bottom of the page) -->
  <Section variant={variantOf('cv')}>
    <DownloadCard
      title="Curriculum vitae"
      description="The full record — publications, teaching, presentations, service, and appointments — on a single PDF."
      fileUrl="/downloads/cutsinger-cv.pdf"
      downloadLabel="Download my CV (PDF)"
    />
  </Section>

  <!-- Peer-reviewed articles -->
  <Section variant={variantOf('articles')}>
    <div class="head">
      <p class="kicker">Publications</p>
      <h2>Peer-reviewed articles.</h2>
    </div>
    <CitationList entries={articles} />
  </Section>

  <!-- Book chapters -->
  {
    bookChapters.length > 0 && (
      <Section variant={variantOf('chapters')}>
        <div class="head">
          <p class="kicker">Publications</p>
          <h2>Book chapters.</h2>
        </div>
        <CitationList entries={bookChapters} />
      </Section>
    )
  }

  <!-- Books -->
  {
    worksInPress.length > 0 && (
      <Section variant={variantOf('books')}>
        <div class="head">
          <p class="kicker">Publications</p>
          <h2>Books.</h2>
        </div>
        <CitationList entries={worksInPress} />
      </Section>
    )
  }

  <!-- Working papers -->
  <Section variant={variantOf('working')}>
    <div class="head">
      <p class="kicker">In progress</p>
      <h2>Working papers.</h2>
      <p class="lede">Current projects — drafts available on request.</p>
    </div>
    <CitationList entries={workingPapers} />
  </Section>

  <CloseBand
    kicker="Collaboration"
    heading="Working on a related question?"
    subtext="I'm glad to hear from students, coauthors, and journalists about monetary policy, economic history, and the political economy of money."
    cta={{ label: 'Get in touch', href: '/contact/' }}
  />
</MarketingLayout>

<style>
  .head { margin-bottom: var(--sp-8); }
  .head h2 { max-width: 22ch; }
  .head .lede { margin-top: var(--sp-3); }
</style>
