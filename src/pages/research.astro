---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHead from '../components/marketing/PageHead.astro';
import Section from '../components/marketing/Section.astro';
import CitationList from '../components/marketing/CitationList.astro';
import DownloadCard from '../components/marketing/DownloadCard.astro';
import CloseBand from '../components/marketing/CloseBand.astro';
import pubs from '../data/publications.json';

// Map the forgiving JSON to CitationList entries. A link renders only for real
// (non-placeholder) rows with a URL — scaffolds never show an invented DOI.
const toEntries = (rows: any[]) =>
  rows.map((r) => ({
    year: r.year,
    authors: r.authors,
    title: r.title,
    venue: r.venue,
    detail: r.status,
    href: !r.placeholder && r.url ? r.url : undefined,
    links: !r.placeholder && r.url ? [{ label: 'DOI', href: r.url }] : undefined,
    placeholder: r.placeholder,
  }));

const worksInPress = toEntries(pubs.worksInPress ?? []);
const articles = toEntries(pubs.articles ?? []);
const bookChapters = toEntries(pubs.bookChapters ?? []);
const workingPapers = toEntries(pubs.workingPapers ?? []);

// Section backgrounds alternate surface/raised across ALL rendered sections. Kept
// data-driven (not hardcoded) so the conditionally-rendered Book chapters / Books
// sections can be empty as publications.json changes without breaking the rhythm.
const sectionOrder = [
  'overview',
  'cv',
  'articles',
  ...(bookChapters.length > 0 ? ['chapters'] : []),
  ...(worksInPress.length > 0 ? ['books'] : []),
  'working',
];
const variantOf = (key: string) =>
  sectionOrder.indexOf(key) % 2 === 0 ? 'surface' : 'raised';
---
<MarketingLayout
  title="Research — Bryan Cutsinger"
  description="Research by Bryan Cutsinger in monetary theory, economic history, and public choice — peer-reviewed articles, working papers, and current projects."
>
  <PageHead
    kicker="Research"
    headline="Money, institutions, and the incentives behind policy."
    lede="My research asks how monetary institutions shape economies, and why the rules governing money look the way they do — spanning monetary theory and economic history, read through the lens of public choice."
  >
    <Fragment slot="headline">
      Money, institutions, and the <em>incentives</em> behind policy.
    </Fragment>
  </PageHead>

  <!-- Overview -->
  <Section variant={variantOf('overview')}>
    <div class="head"><p class="kicker">Overview</p><h2>What I work on.</h2></div>
    <div class="overview">
      <p>
        Most of my published research sits at the intersection of monetary economics and
        economic history. A recurring theme is seigniorage — the revenue governments raise
        by creating money — and how monetary institutions determine who ultimately bears its
        cost. I've examined episodes ranging from the hyperinflation of Revolutionary France
        and paper money in colonial French North America to money and seigniorage in the
        Confederate South, alongside present-day questions about the Federal Reserve's
        post-2008 operating regime, interest on reserves, and whether a return to the gold
        standard is feasible. A second strand brings public choice — the economics of
        political incentives — to bear on legislation, from the durability of legislative
        benefits to the insurance of legislative wealth transfers. Running through much of it
        is a methodological argument, made with Alexander Salter, for putting price theory
        back at the center of how economists work, and for defending the economic approach to
        human behavior against calls to replace it.
      </p>
      <p>
        My current work carries these questions forward. In monetary theory and history, a
        framework developed with Joshua Hendrickson explains how an issuer's credibility in
        redeeming paper money for gold shapes note discounts, exchange rates, and the price
        level; a cross-country study with Casey Pender asks whether deflation's consequences
        depend on its source, using thirteen economies under the classical gold standard to
        show that supply-driven price declines behave nothing like the demand-driven kind.
        Other projects, several under review, take up the political economy of monetary and
        academic institutions — the Federal Reserve's 2025 framework review, how regime type
        governs the "monetary commons," the competitiveness of antebellum free-banking
        systems, and structural conflicts of interest in higher education. A book with
        Alexander Salter, <em>Based Money: A Citizen's Guide to Money Mischief and Fiscal
        Folly</em>, is under contract with the Independent Institute and expected in 2027.
      </p>
    </div>
  </Section>

  <!-- CV (promoted from the bottom of the page) -->
  <Section variant={variantOf('cv')}>
    <DownloadCard
      title="Curriculum vitae"
      description="The full record — publications, teaching, presentations, service, and appointments — on a single PDF."
      fileUrl="/downloads/cutsinger-cv.pdf"
      downloadLabel="Download my CV (PDF)"
    />
  </Section>

  <!-- Peer-reviewed articles -->
  <Section variant={variantOf('articles')}>
    <div class="head">
      <p class="kicker">Publications</p>
      <h2>Peer-reviewed articles.</h2>
    </div>
    <CitationList entries={articles} />
  </Section>

  <!-- Book chapters -->
  {
    bookChapters.length > 0 && (
      <Section variant={variantOf('chapters')}>
        <div class="head">
          <p class="kicker">Publications</p>
          <h2>Book chapters.</h2>
        </div>
        <CitationList entries={bookChapters} />
      </Section>
    )
  }

  <!-- Books -->
  {
    worksInPress.length > 0 && (
      <Section variant={variantOf('books')}>
        <div class="head">
          <p class="kicker">Publications</p>
          <h2>Books.</h2>
        </div>
        <CitationList entries={worksInPress} />
      </Section>
    )
  }

  <!-- Working papers -->
  <Section variant={variantOf('working')}>
    <div class="head">
      <p class="kicker">In progress</p>
      <h2>Working papers.</h2>
      <p class="lede">Current projects — drafts available on request.</p>
    </div>
    <CitationList entries={workingPapers} />
  </Section>

  <CloseBand
    kicker="Collaboration"
    heading="Working on a related question?"
    subtext="I'm glad to hear from students, coauthors, and journalists about monetary policy, economic history, and the political economy of money."
    cta={{ label: 'Get in touch', href: '/contact/' }}
  />
</MarketingLayout>

<style>
  .head { margin-bottom: var(--sp-8); }
  .head h2 { max-width: 22ch; }
  .head .lede { margin-top: var(--sp-3); }
  /* Overview — research-statement prose. Paragraphs inherit the base Newsreader
     reading face, 68ch measure, and line-height from site.css; we only add the
     hairline top-rule (kept from the old .fields block) and trim the last margin. */
  .overview {
    border-top: 1px solid var(--hairline); padding-top: var(--sp-8);
  }
  .overview p:last-child { margin-bottom: 0; }
</style>
