---
import { Image } from 'astro:assets';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHead from '../components/marketing/PageHead.astro';
import Section from '../components/marketing/Section.astro';
import Button from '../components/marketing/Button.astro';
import CloseBand from '../components/marketing/CloseBand.astro';

import headshot from '../assets/bryan-cutsinger.png';
import onStageGesturing from '../assets/on-stage-gesturing.jpg';

const glance = [
  { label: 'Position', value: 'Economics professor, Florida Atlantic University' },
  { label: 'Editorial', value: 'Associate Editor, <em>Public Choice</em>' },
  { label: 'Affiliation', value: 'Interim Director, Sound Money Project — American Institute for Economic Research (AIER)' },
  { label: 'Research', value: 'Monetary theory · Economic history · Public choice' },
  { label: 'Writing', value: 'National Review · The Hill · The Washington Examiner · RealClearEducation' },
];

const speakChips = [
  'The politics of money',
  'Sound money & monetary rules',
  'Public choice',
  'Current economic debates',
];
---
<MarketingLayout
  title="About — Bryan Cutsinger"
  description="Bryan Cutsinger is an economics professor at Florida Atlantic University, interim director of the Sound Money Project at the American Institute for Economic Research, and Associate Editor of Public Choice. He works in monetary theory and economic history, has written for National Review, The Hill, and The Washington Examiner, and speaks to audiences seeking clear economic analysis of money, markets, and public policy."
>
  <PageHead
    kicker="About"
    edition="Florida Atlantic University"
    headline="Bryan Cutsinger."
    lede="Bryan works on monetary theory, economic history, and public choice, with a focus on the institutions and incentives that shape markets and policy."
  />

  <!-- Short bio + portrait -->
  <Section variant="surface">
    <div class="bio-lead">
      <div class="bio-lead__copy">
        <p class="kicker">The short version</p>
        <h2>Bio for hosts.</h2>
        <p>
          Bryan Cutsinger is an economics professor at Florida Atlantic University
          whose research focuses on monetary theory and economic history. He is
          interim director of the Sound Money Project at the American Institute for
          Economic Research and serves as Associate Editor of <em>Public Choice</em>.
          His commentary has appeared in <em>National Review</em>, <em>The Hill</em>,
          and <em>The Washington Examiner</em>. He writes and speaks for audiences
          that want serious economics explained in plain language.
        </p>
        <p class="bio-lead__hint">
          <strong>For hosts:</strong> this version may be used in event programs,
          introductions, and promotional materials.
        </p>
      </div>
      <figure class="bio-lead__portrait">
        <Image src={headshot} alt="Bryan Cutsinger" width={420} densities={[1, 2]} />
      </figure>
    </div>
  </Section>

  <!-- Long bio -->
  <Section variant="raised" width="reading">
    <div class="head"><p class="kicker">The longer story</p><h2>About Bryan.</h2></div>
    <p>
      Bryan's work sits at the intersection of monetary theory, economic history,
      and political economy. He studies how monetary institutions develop, how
      policy choices shape incentives, and why the rules around money matter for
      markets, public finance, and everyday economic life.
    </p>
    <p>
      At Florida Atlantic University, Bryan teaches economics and works with
      students on the economic way of thinking: prices, tradeoffs, property rights,
      and the institutions that help people coordinate their plans. His teaching
      materials reflect the same approach he brings to public work: clear
      arguments, careful definitions, and examples that make abstract ideas easier
      to test.
    </p>
    <p>
      Bryan also writes and speaks for audiences outside the classroom. His
      commentary and talks connect current debates to the economic ideas behind
      them, especially when the topic is money, inflation, central banking, public
      choice, or the political incentives built into policy.
    </p>
  </Section>

  <!-- At a glance -->
  <Section variant="surface" width="reading">
    <div class="head"><p class="kicker">At a glance</p><h2>The essentials.</h2></div>
    <dl class="glance">
      {
        glance.map((g) => (
          <div class="glance__row">
            <dt class="label">{g.label}</dt>
            <dd set:html={g.value} />
          </div>
        ))
      }
    </dl>
  </Section>

  <!-- On the stage -->
  <Section variant="raised">
    <div class="about-speak">
      <div class="about-speak__copy">
        <div class="head"><p class="kicker">On the stage</p><h2>What I speak about.</h2></div>
        <ul class="chips">
          {speakChips.map((c) => <li>{c}</li>)}
        </ul>
        <Button href="/speaking/" variant="secondary">See speaking topics</Button>
      </div>
      <figure class="about-speak__media">
        <Image
          src={onStageGesturing}
          alt="Bryan Cutsinger speaking to an executive-education audience"
          width={640}
          densities={[1, 2]}
        />
      </figure>
    </div>
  </Section>

  <CloseBand
    kicker="Booking"
    heading="Bring Bryan to your next event."
    subtext="Keynotes, lectures, and panels for universities, conferences, and professional audiences."
    cta={{ label: 'Invite me to speak', href: '/speaking/' }}
  />
</MarketingLayout>

<style>
  .head { margin-bottom: var(--sp-6); }

  .bio-lead {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: var(--sp-16);
    align-items: start;
  }
  .bio-lead__hint {
    margin-top: var(--sp-6);
    padding: var(--sp-4) var(--sp-6);
    background: var(--accent-tint);
    border-radius: var(--radius);
    font-size: var(--fs-small);
    color: var(--ink);
    max-width: none;
  }
  .bio-lead__portrait { margin: 0; }
  .bio-lead__portrait img { border-radius: var(--radius-lg); filter: grayscale(0.15); }

  .glance { margin: 0; }
  .glance__row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--sp-6);
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--hairline);
  }
  .glance__row:first-child { border-top: 1px solid var(--hairline); }
  .glance dt { padding-top: 3px; }
  .glance dd { margin: 0; color: var(--ink); }
  .glance dd :global(em) { font-style: italic; }

  .about-speak {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-16);
    align-items: center;
  }
  .about-speak__media { margin: 0; }
  .about-speak__media img { border-radius: var(--radius-lg); }
  .chips { list-style: none; margin: 0 0 var(--sp-8); padding: 0; display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .chips li {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--sp-2) var(--sp-4);
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .bio-lead { grid-template-columns: 1fr; gap: var(--sp-8); }
    .bio-lead__portrait { max-width: 260px; }
    .about-speak { grid-template-columns: 1fr; gap: var(--sp-8); }
    .glance__row { grid-template-columns: 1fr; gap: var(--sp-1); }
  }
</style>
