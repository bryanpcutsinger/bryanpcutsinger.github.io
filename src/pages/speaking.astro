---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Hero from '../components/marketing/Hero.astro';
import Section from '../components/marketing/Section.astro';
import SectionHeading from '../components/marketing/SectionHeading.astro';
import TopicGrid from '../components/marketing/TopicGrid.astro';
import AsSeenIn from '../components/marketing/AsSeenIn.astro';
import TestimonialRow from '../components/marketing/TestimonialRow.astro';
import DownloadCard from '../components/marketing/DownloadCard.astro';
import BookingForm from '../components/marketing/BookingForm.astro';
import CTABand from '../components/marketing/CTABand.astro';
import PortraitFigure from '../components/marketing/PortraitFigure.astro';

import speakingHero from '../assets/speaking-hero.jpg';
import topicsData from '../data/topics.json';
import testimonialsData from '../data/testimonials.json';
import logosData from '../data/logos.json';

const topics = topicsData.topics; // full list, no outbound links here
const testimonials = testimonialsData.items;

// PLACEHOLDER — Bryan: confirm which audience types are accurate.
const audiences = [
  'Universities & academic events',
  'Conferences & summits',
  'Policy organizations & think tanks',
  'Professional & corporate audiences',
  'Student organizations',
];
---
<MarketingLayout
  title="Speaking — Bryan Cutsinger"
  description="Invite Bryan Cutsinger to speak. Keynotes and lectures on monetary policy, economic history, and public choice — the economics behind the headlines, made clear for any audience."
>
  <Hero
    eyebrow="Speaking"
    headline="Bring the economics behind the headlines to your audience."
    subhead="An economist who can make monetary policy, economic history, and the incentives behind public policy genuinely clear — and genuinely interesting — to people who don't live in the seminar room."
    primaryCta={{ label: 'Check availability', href: '#book' }}
    secondaryCta={{ label: 'See topics', href: '#topics' }}
  >
    <PortraitFigure
      slot="media"
      src={speakingHero}
      ratio="portrait"
      alt="Bryan Cutsinger presenting at Florida Atlantic University"
    />
  </Hero>

  <!-- Signature topics -->
  <Section variant="surface" id="topics">
    <SectionHeading
      eyebrow="Signature talks"
      heading="What I speak about."
      lede="Each talk is tailored to the audience and the occasion. These are starting points — tell me who's in the room and we'll shape it together."
    />
    <TopicGrid topics={topics} columns={2} />
    <p class="topics-note">
      Looking for something specific? I regularly build custom talks around a
      host's theme. <a href="#book">Tell me what you have in mind.</a>
    </p>
  </Section>

  <!-- Who I speak to -->
  <Section variant="raised">
    <SectionHeading eyebrow="Who I speak to" heading="Audiences." />
    <ul class="audience-list">
      {audiences.map((a) => <li>{a}</li>)}
    </ul>
  </Section>

  <!-- Social proof -->
  <Section variant="surface">
    <AsSeenIn label="Featured in" logos={logosData.logos} />
    {
      testimonials.length > 0 && (
        <div class="speaking-testimonials">
          <TestimonialRow items={testimonials} />
        </div>
      )
    }
  </Section>

  <!-- Formats, logistics, one-sheet -->
  <Section variant="raised">
    <div class="logistics">
      <div class="logistics__col">
        <SectionHeading eyebrow="Formats" heading="How we can work together." />
        <ul class="logistics__list">
          <li>Keynotes</li>
          <li>Lectures &amp; campus visits</li>
          <li>Panels &amp; moderated conversations</li>
          <li>Workshops &amp; seminars</li>
          <li>Virtual talks &amp; webinars</li>
        </ul>
        <p class="logistics__fee">
          Fees depend on format, audience, and travel. <a href="#book">Get in
          touch</a> and I'll send details.
        </p>
      </div>
      <div class="logistics__col">
        <DownloadCard
          title="Speaker one-sheet"
          description="Bio, signature topics, and booking details on a single page — handy for sharing with your committee."
          requestHref="#book"
        />
      </div>
    </div>
  </Section>

  <!-- Booking -->
  <Section variant="surface" id="book" width="wide">
    <SectionHeading
      eyebrow="Get in touch"
      heading="Invite Bryan to speak."
      lede="Tell me about your event and I'll get back to you personally. The more detail you can share, the faster I can say yes."
    />
    <BookingForm />
  </Section>

  <CTABand
    heading="Let's give your audience the economics they actually want."
    cta={{ label: 'Start a conversation', href: '#book' }}
  />
</MarketingLayout>

<style>
  .topics-note {
    margin: var(--sp-12) auto 0;
    text-align: center;
    color: var(--text-muted);
    max-width: 60ch;
  }
  .audience-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--sp-4);
  }
  .audience-list li {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--sp-4) var(--sp-6);
    font-weight: 500;
  }
  .speaking-testimonials {
    margin-top: var(--sp-16);
  }
  .logistics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-16);
    align-items: start;
  }
  .logistics__list {
    list-style: none;
    margin: 0 0 var(--sp-6);
    padding: 0;
  }
  .logistics__list li {
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--hairline);
    font-size: 1.05rem;
  }
  .logistics__fee {
    color: var(--text-muted);
  }
  @media (max-width: 820px) {
    .logistics {
      grid-template-columns: 1fr;
      gap: var(--sp-8);
    }
  }
</style>
