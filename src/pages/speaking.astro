---
import { Image } from 'astro:assets';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHead from '../components/marketing/PageHead.astro';
import Section from '../components/marketing/Section.astro';
import Button from '../components/marketing/Button.astro';
import BookingForm from '../components/marketing/BookingForm.astro';

import speakingCharleston from '../assets/speaking-charleston.jpg';
import salveLecture from '../assets/salve-regina-lecture.jpg';
import fauResearchPark from '../assets/on-stage-gesturing.jpg';
import utepLecture from '../assets/utep-lecture.jpg';
import fedPolicyUnderPressure from '../assets/on-stage-podium.jpg';

import topicsData from '../data/topics.json';
import testimonialsData from '../data/testimonials.json';

const talks = topicsData.topics;
const testimonials = testimonialsData.items ?? [];

const formats = [
  { name: 'Keynotes', note: 'A signature talk shaped to your theme and audience.' },
  { name: 'Economic briefings', note: 'A current, data-driven outlook followed by audience questions.' },
  { name: 'Lectures & campus visits', note: 'For universities, honors programs, and student groups.' },
  { name: 'Panels & moderated conversations', note: 'On the economic outlook, monetary policy, and regional conditions.' },
  { name: 'Workshops & seminars', note: 'Smaller, participatory sessions for professional groups.' },
  { name: 'Virtual talks & webinars', note: 'Remote keynotes and Q&A for distributed audiences.' },
];

const audiences = [
  'Universities & academic events',
  'Conferences & summits',
  'Chambers of commerce & civic organizations',
  'Banks, financial firms & business associations',
  'Policy organizations & think tanks',
  'Donor & membership organizations',
  'Corporate & executive audiences',
];

const venues = [
  'FAU Research Park',
  'Chamber of Commerce of the Palm Beaches',
  'Greater Boca Raton Chamber of Commerce',
  'Creighton University',
  'University of Texas at El Paso',
  'Wabash College',
  'College of Charleston',
  'Salve Regina University',
  'Florida Southern College',
];
---
<MarketingLayout
  title="Speaking — Bryan Cutsinger"
  description="Invite economist Bryan Cutsinger to speak on the U.S. economic outlook, South Florida's regional economy, or monetary policy for business, civic, academic, and policy audiences."
>
  <PageHead
    edition="Booking open"
    headline="Economic ideas your audience can use."
    lede="I turn current data, monetary economics, and economic history into clear briefings on the U.S. outlook, South Florida's regional economy, and monetary policy — shaped to your audience and event."
  >
    <Fragment slot="headline">
      Economic ideas your audience can <em>use</em>.
    </Fragment>
  </PageHead>

  <!-- Primary booking affordance up top -->
  <Section variant="surface">
    <div class="book-lead">
      <div class="book-lead__cta">
        <Button href="#book" variant="action">Check availability</Button>
      </div>
      <p class="book-lead__details">
        <span class="label">Availability</span>
        Local, national, and virtual engagements are available. Travel expenses
        are handled separately for in-person events outside South Florida.
      </p>
    </div>
  </Section>

  <!-- Signature topics as outcomes -->
  <Section variant="surface" id="topics">
    <div class="head">
      <h2>Signature talks.</h2>
      <p class="lede">
        Starting points, not scripts — each talk is adjusted to the host,
        audience, and occasion.
      </p>
    </div>
    <ol class="topics">
      {
        talks.map((t) => (
          <li class="topic">
            <p class="topic__meta label">{t.format} · {t.audience}</p>
            <h3 class="topic__title">{t.title}</h3>
            <p class="topic__dek">{t.description}</p>
            {t.href && (
              <p class="topic__source">
                <a href={t.href} rel="noopener">{t.linkLabel} ↗</a>
              </p>
            )}
          </li>
        ))
      }
    </ol>
    <p class="topics-note">
      Need a different angle? Share the theme and audience, and I'll shape a talk
      around it. <a href="#book">Tell me what you have in mind.</a>
    </p>
  </Section>

  <!-- On the stage -->
  <Section variant="sunk">
    <div class="head"><h2>See a talk.</h2></div>
    <figure class="stage-photo">
      <Image
        src={utepLecture}
        alt="Bryan Cutsinger gesturing toward a chart of inflation survey data during a talk at the University of Texas at El Paso"
        widths={[600, 960, 1280]}
        sizes="(min-width: 960px) 960px, 100vw"
        loading="lazy"
      />
      <figcaption>Speaking at the University of Texas at El Paso.</figcaption>
    </figure>
    <div class="stage-grid">
      <figure class="stage-photo">
        <Image
          src={fedPolicyUnderPressure}
          alt="Bryan Cutsinger gesturing while discussing Nixon-era pressure on the Federal Reserve at the AIER Fed Policy Under Pressure conference at FAU"
          widths={[480, 800, 1200]}
          sizes="(min-width: 820px) 25vw, 50vw"
          loading="lazy"
        />
        <figcaption>Speaking on central bank independence at AIER's "Fed Policy Under Pressure" conference, FAU.</figcaption>
      </figure>
      <figure class="stage-photo">
        <Image
          src={salveLecture}
          alt="Bryan Cutsinger pointing to a slide while lecturing on inflation to a full lecture hall at Salve Regina University"
          widths={[480, 800, 1200]}
          sizes="(min-width: 820px) 25vw, 50vw"
          loading="lazy"
        />
        <figcaption>Guest lecture on inflation and Fed policy at Salve Regina University.</figcaption>
      </figure>
      <figure class="stage-photo">
        <Image
          src={fauResearchPark}
          alt="Bryan Cutsinger briefing a business audience on South Florida economic data at the FAU Research Park presentation"
          widths={[480, 800, 1200]}
          sizes="(min-width: 820px) 25vw, 50vw"
          loading="lazy"
        />
        <figcaption>This year's FAU Research Park presentation.</figcaption>
      </figure>
      <figure class="stage-photo">
        <Image
          src={speakingCharleston}
          alt="Bryan Cutsinger presenting to an audience from the podium at the College of Charleston"
          widths={[480, 800, 1200]}
          sizes="(min-width: 820px) 25vw, 50vw"
          loading="lazy"
        />
        <figcaption>Presenting at the College of Charleston.</figcaption>
      </figure>
    </div>
  </Section>

  <!-- Formats + audiences -->
  <Section variant="surface">
    <div class="two-col">
      <div>
        <div class="head"><h2>How we can work together.</h2></div>
        <ul class="ledger">
          {formats.map((f) => (
            <li>
              <span class="ledger__name">{f.name}</span>
              <span class="ledger__note">{f.note}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <div class="head"><h2>Who I speak to.</h2></div>
        <ul class="chips">
          {audiences.map((a) => <li>{a}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <Section variant="sunk">
    <div class="head">
      <h2>Where I've spoken.</h2>
      <p class="lede">
        Selected universities, chambers, and professional audiences from past
        engagements.
      </p>
    </div>
    <ul class="venues">
      {venues.map((venue) => <li>{venue}</li>)}
    </ul>
  </Section>

  {
    testimonials.length > 0 && (
      <Section variant="sunk">
        <div class="head"><h2>From the room.</h2></div>
        <ul class="quotes">
          {testimonials.map((q: any) => (
            <li class="quote">
              <blockquote>{q.quote}</blockquote>
              <p class="quote__by label">{q.name}{q.title ? ` · ${q.title}` : ''}</p>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <!-- Booking -->
  <Section variant="ink" id="book">
    <div class="head head--on-field"><h2>Invite Bryan to speak.</h2>
      <p class="lede book-lede">
        Tell me about your event and I'll get back to you personally. The more
        detail you can share, the faster I can respond.
      </p>
    </div>
    <BookingForm />
  </Section>
</MarketingLayout>

<style>
  .head {
    border-top: 3px double var(--structure);
    padding-top: var(--sp-6);
    margin-bottom: var(--sp-8);
  }
  .head h2 { max-width: 22ch; margin-bottom: var(--sp-2); }
  .head .lede { margin-top: var(--sp-3); }
  .head--on-field { border-top-color: rgba(236, 233, 226, 0.25); }

  /* booking lead */
  .book-lead {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-8) var(--sp-16);
    align-items: center;
  }
  .book-lead__cta { display: flex; align-items: center; gap: var(--sp-4); flex-wrap: wrap; }
  .book-lead__details { margin: 0; color: var(--muted); max-width: 60ch; }
  .book-lead__details .label { display: block; margin-bottom: var(--sp-2); }

  /* topics */
  .topics {
    list-style: none; margin: 0; padding: var(--sp-8) 0 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-12) var(--sp-16);
    border-top: 0;
  }
  .topic__meta { display: block; margin-bottom: var(--sp-3); }
  .topic__title { font-size: var(--fs-h3); margin: 0 0 var(--sp-3); }
  .topic__dek { margin: 0; color: var(--muted); }
  .topic__source { margin: var(--sp-3) 0 0; font-family: var(--font-label); font-size: 0.85rem; }
  .topics-note { margin: var(--sp-12) auto 0; text-align: center; color: var(--muted); max-width: 56ch; }

  /* on-stage photo */
  .stage-photo { margin: 0 0 var(--sp-8); }
  .stage-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--rule-strong);
    box-shadow: var(--shadow-hover);
  }
  .stage-photo figcaption {
    margin-top: var(--sp-3);
    font-family: var(--font-label);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .stage-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-8);
  }
  .stage-grid .stage-photo { margin-bottom: 0; }
  .stage-grid .stage-photo img { aspect-ratio: 3 / 2; object-fit: cover; }

  /* two-col formats/audiences */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-16); align-items: start; }
  .ledger { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hairline); }
  .ledger li { display: flex; flex-direction: column; gap: 2px; padding: var(--sp-4) 0; border-bottom: 1px solid var(--hairline); }
  .ledger__name { font-family: var(--font-display); font-size: 1.15rem; color: var(--ink); }
  .ledger__note { color: var(--muted); font-size: 0.95rem; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-2); }
  .chips li {
    font-family: var(--font-display); font-size: 1.2rem; color: var(--ink);
    padding: var(--sp-3) 0; border-bottom: 1px solid var(--hairline);
  }

  .venues {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--hairline);
  }
  .venues li {
    padding: var(--sp-4) var(--sp-6) var(--sp-4) 0;
    border-bottom: 1px solid var(--hairline);
    font-family: var(--font-display);
    font-size: 1.08rem;
  }

  /* quotes */
  .quotes { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-8); }
  .quote blockquote { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.35; margin: 0 0 var(--sp-3); color: var(--ink); }
  .quote__by { color: var(--muted); }

  @media (max-width: 1100px) {
    .stage-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 820px) {
    .book-lead { grid-template-columns: 1fr; gap: var(--sp-6); }
    .topics { grid-template-columns: 1fr; gap: var(--sp-8); }
    .two-col { grid-template-columns: 1fr; gap: var(--sp-12); }
    .venues { grid-template-columns: 1fr; }
    .stage-grid { grid-template-columns: 1fr; }
  }
</style>
