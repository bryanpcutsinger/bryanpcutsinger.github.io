---
// Wrap (don't replace) Starlight's default Footer so the prev/next pager,
// last-updated, and edit-link slots are preserved — then append the BRAND
// footer, mirroring the marketing SiteFooter.astro (wordmark + tagline on the
// left, verified profile links on the right, copyright bar below). Colors are
// site.css tokens inlined (--ink #1a1917, --on-ink #f6f4ee, --on-ink-muted
// #b4afa6, --accent-on-ink #b8d0c6) since Starlight pages don't load site.css.
// It spans the CONTENT column (not the viewport) — the docs sidebar owns the
// left rail all the way down, so a viewport-wide band would collide with it.
import Default from '@astrojs/starlight/components/Footer.astro';

const year = new Date().getFullYear();

// Real, verified profile URLs only — same list as the marketing SiteFooter and
// the Person JSON-LD `sameAs`. Never add a placeholder/invented profile link.
const social = [
  {
    label: 'X (Twitter)',
    href: 'https://x.com/BryanPCutsinger',
    icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/bryan-cutsinger-2654613a2/',
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z',
  },
  {
    label: 'Google Scholar',
    href: 'https://scholar.google.com/citations?user=j1xhP4kAAAAJ&hl=en',
    icon: 'M12 24a7 7 0 110-14 7 7 0 010 14zm0-24L0 9.5l4.838 3.94A8 8 0 0112 9a8 8 0 017.162 4.44L24 9.5z',
  },
];
---
<Default><slot /></Default>

<footer class="fau-site-footer">
  <div class="fau-site-footer__inner">
    <div>
      <a href="/" class="footer-wordmark">Bryan&nbsp;Cutsinger</a>
      <p class="footer-tagline">Economist · Florida Atlantic University</p>
    </div>
    <nav class="footer-social" aria-label="Profiles">
      {social.map((s) => (
        <a href={s.href} aria-label={s.label} title={s.label} rel="me noopener" target="_blank">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d={s.icon} />
          </svg>
        </a>
      ))}
    </nav>
  </div>
  <div class="fau-site-footer__credit">
    <p>© {year} Bryan Cutsinger</p>
  </div>
</footer>

<style>
  .fau-site-footer {
    margin-top: 4rem;
    background: #242932;
    color: #ece9e2;
    /* full-bleed across the content column */
    margin-inline: calc(-1 * var(--sl-content-pad-x, 1rem));
  }
  .fau-site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding: 3rem var(--sl-content-pad-x, 1rem) 2.25rem;
  }
  .footer-wordmark {
    font-family: 'Besley Variable', Georgia, 'Times New Roman', serif;
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    color: #ece9e2;
    text-decoration: none;
  }
  .footer-wordmark:hover {
    color: #ece9e2;
    opacity: 0.85;
  }
  .footer-tagline {
    margin: 0.5rem 0 0;
    color: #a7a49c;
    font-size: 0.875rem;
  }
  .footer-social {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .footer-social a {
    color: #a7a49c;
    display: inline-flex;
    transition: color 0.15s ease;
  }
  .footer-social a:hover {
    color: #dfa091;
  }
  .fau-site-footer__credit {
    border-top: 1px solid rgba(236, 233, 226, 0.12);
  }
  .fau-site-footer__credit p {
    margin: 0;
    padding: 1.25rem var(--sl-content-pad-x, 1rem);
    font-size: 0.875rem;
    color: #a7a49c;
  }
</style>
