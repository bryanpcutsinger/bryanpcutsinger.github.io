---
// Overrides Starlight's `SocialIcons` slot (empty — no socials configured) to
// reproduce the marketing SiteHeader's nav inside the /ai/ guides: same links
// (including "AI", shown active since this chrome only renders under /ai/),
// same uppercase Libre Franklin label voice. No header CTA (v5 decision —
// the Speaking pages carry the action). Values mirror site.css tokens
// (--on-field #ece9e2, --on-field-muted #a7a49c, --action-inverse #dfa091,
// --action #a33b2a) — Starlight pages don't load site.css, so they're inlined.
//
// MOBILE FIX (2026-07-22): Starlight renders this component in TWO places —
// the top header bar (navy) and the MobileMenuFooter inside the sidebar
// drawer (light stone). It used to display:none below 50rem, which removed
// the marketing nav entirely on phones (the drawer only covers docs nav).
// Now only the HEADER copy hides on small screens; the drawer copy renders
// with dark-on-light styling, so every marketing section stays reachable.
const links = [
  { label: 'Speaking', href: '/speaking/' },
  { label: 'Writing', href: '/writing/' },
  { label: 'Research', href: '/research/' },
  { label: 'Teaching', href: '/teaching/' },
  { label: 'AI', href: '/ai/', active: true },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];
---
<nav class="header-links" aria-label="Site">
  {
    links.map((l) => (
      <a
        href={l.href}
        class:list={['nav-link', { 'is-active': l.active }]}
        aria-current={l.active ? 'page' : undefined}
      >
        {l.label}
      </a>
    ))
  }
</nav>

<style>
  .header-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 1.3rem;
  }
  /* base = the mobile-drawer context: dark labels on the light stone pane */
  .nav-link {
    font-family: 'Libre Franklin Variable', -apple-system, BlinkMacSystemFont,
      'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #26282c;
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover {
    color: #a33b2a;
    border-bottom-color: rgba(163, 59, 42, 0.4);
  }
  .nav-link.is-active {
    border-bottom-color: #a33b2a;
  }

  /* header context: light labels on the navy bar */
  :global(header.header) .nav-link {
    color: #a7a49c;
  }
  :global(header.header) .nav-link:hover {
    color: #ece9e2;
    border-bottom-color: rgba(236, 233, 226, 0.4);
  }
  :global(header.header) .nav-link.is-active {
    color: #ece9e2;
    border-bottom-color: #dfa091;
  }

  /* hide only the HEADER copy on narrow screens — the drawer copy (rendered
     by Starlight's MobileMenuFooter) takes over there */
  @media (max-width: 50rem) {
    :global(header.header) .header-links {
      display: none;
    }
  }
</style>
