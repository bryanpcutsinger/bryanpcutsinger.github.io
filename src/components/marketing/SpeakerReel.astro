---
// Speaker reel feature on the ink base. THREE graceful states:
//   1. `videoUrl` set        -> responsive 16:9 embed.
//   2. no video, `fallback`
//      slot has a photo       -> cinematic on-stage still + caption + CTA
//                                (the launch state, since no reel exists yet).
//   3. neither                -> renders nothing (section omitted).
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  heading?: string;
  videoUrl?: string;
  caption?: string;
  cta?: { label: string; href: string };
}
const {
  eyebrow = 'On the stage',
  heading,
  videoUrl,
  caption,
  cta,
} = Astro.props;
const hasFallback = Astro.slots.has('fallback');
const show = !!videoUrl || hasFallback;
---
{
  show && (
    <section class="reel">
      <div class="reel__inner">
        <div class="reel__head">
          {eyebrow && <Eyebrow text={eyebrow} />}
          {heading && <h2 class="reel__heading">{heading}</h2>}
        </div>

        {videoUrl ? (
          <div class="reel__video">
            <iframe
              src={videoUrl}
              title="Speaker reel"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        ) : (
          <div class="reel__photo">
            <slot name="fallback" />
          </div>
        )}

        {(caption || cta) && (
          <div class="reel__foot">
            {caption && <p class="reel__caption">{caption}</p>}
            {cta && (
              <Button href={cta.href} variant="ghost-ink">
                {cta.label}
              </Button>
            )}
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .reel {
    background: var(--ink);
    color: var(--on-ink);
    padding-block: var(--section-y-ink);
  }
  .reel__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--sp-6);
  }
  .reel__head {
    text-align: center;
    margin-bottom: var(--sp-8);
  }
  .reel__heading {
    font-size: var(--fs-h2);
    color: var(--on-ink);
    margin: 0;
  }
  .reel__video {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .reel__video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .reel__photo :global(img),
  .reel__photo :global(.portrait) {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .reel__foot {
    text-align: center;
    margin-top: var(--sp-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
  }
  .reel__caption {
    color: var(--on-ink-muted);
    font-size: var(--fs-lead);
    margin: 0;
    max-width: 52ch;
  }
</style>
