---
// DatedList — the site's backbone record. A ruled list where the year/date sits
// in the left column as accent tabular figures and the entry (title + meta) reads
// to its right. Rows link only when a real `href` is given. Single small-screen
// behavior: below 640px the row stacks (date above the entry) — no second layout.
//
// items: { date, title, meta?, href?, note?, external?, placeholder? }[]
//   date  — short display string (a year "2024", or "Jun 2026"); shown in accent
//   meta  — venue / outlet / format, set in the label voice
//   note  — a short trailing status ("Working paper", "R&R")
//   external — render an ↗ and rel=noopener for off-site links
interface Item {
  date?: string;
  title: string;
  meta?: string;
  href?: string;
  note?: string;
  external?: boolean;
  placeholder?: boolean;
}
interface Props {
  items: Item[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---
<ul class:list={['drec', className]}>
  {
    items.map((it) => {
      const Tag = it.href ? 'a' : 'div';
      const rel = it.external ? 'noopener noreferrer' : undefined;
      const target = it.external ? '_blank' : undefined;
      return (
        <li class:list={['drec__item', { 'is-placeholder': it.placeholder }]}>
          <Tag
            class:list={['drec__row', { 'is-link': !!it.href }]}
            href={it.href}
            rel={rel}
            target={target}
          >
            <span class="drec__date tnum">{it.date}</span>
            <span class="drec__body">
              <span class="drec__title">
                {it.title}
                {it.external && it.href && (
                  <span class="drec__ext" aria-hidden="true"> ↗</span>
                )}
              </span>
              {it.meta && <span class="drec__meta label">{it.meta}</span>}
            </span>
            {it.note && <span class="drec__note">{it.note}</span>}
            {it.placeholder && <span class="drec__flag">Placeholder</span>}
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  /* the ruled dated record — the site's signature device */
  .drec {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 3px double var(--structure);
  }
  .drec__item {
    border-bottom: 1px solid var(--structure);
  }
  .drec__row {
    display: grid;
    grid-template-columns: 5.25rem 1fr auto;
    align-items: baseline;
    gap: var(--sp-2) 0;
    padding: var(--sp-4) 0;
    text-decoration: none;
    color: var(--text);
  }
  .drec__date {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 650;
    color: var(--action);
    letter-spacing: 0.03em;
  }
  .drec__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    min-width: 0;
    border-left: 3px double var(--structure);
    padding-left: 1.4rem;
  }
  .drec__title {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 550;
    line-height: 1.3;
    color: var(--text);
  }
  .drec__meta {
    margin-top: 2px;
  }
  .drec__note {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
    margin-left: var(--sp-4);
  }
  .drec__ext { color: var(--action); font-size: 0.85em; }

  /* linked rows: quiet card wash + title picks up the action hue */
  .drec__row.is-link:hover {
    background: rgba(247, 245, 240, 0.55);
  }
  .drec__row.is-link:hover .drec__title { color: var(--action-hover); }
  .drec__row.is-link:focus-visible { outline-offset: -2px; }

  /* honest scaffold state */
  .drec__item.is-placeholder { opacity: 0.62; }
  .drec__flag {
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
  }

  /* small screens keep the date gutter (narrower), per the v5 record grammar */
  @media (max-width: 640px) {
    .drec__row {
      grid-template-columns: 3.6rem 1fr;
    }
    .drec__date { font-size: 0.8rem; }
    .drec__body { padding-left: 0.9rem; }
    .drec__note { grid-column: 2; margin-left: 0; padding-left: calc(0.9rem + 3px); }
  }
</style>
