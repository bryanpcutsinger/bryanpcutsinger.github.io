---
// "Invite me to speak" inquiry form. Posts to Web3Forms (free, static-host
// friendly, no backend). Progressive enhancement: a tiny inline script submits
// via fetch and shows an inline success/error state; without JS it still POSTs
// normally. Honeypot ("botcheck") for spam.
//
// PLACEHOLDER — Bryan must do two things before this works:
//   1. Create a free Web3Forms access key (web3forms.com) tied to your booking
//      email and paste it into ACCESS_KEY below.
//   2. Confirm the fallback booking email in `email` (a dedicated speaking
//      inbox is recommended over the FAU address).
const ACCESS_KEY = 'YOUR_WEB3FORMS_ACCESS_KEY'; // PLACEHOLDER — Bryan to fill

interface Props {
  email?: string;
}
const { email = 'bcutsinger@fau.edu' } = Astro.props;

const audienceOptions = [
  'University / academic',
  'Conference',
  'Policy / think tank',
  'Student organization',
  'Corporate / professional',
  'Other',
];
const formatOptions = [
  'Keynote',
  'Lecture',
  'Panel',
  'Workshop',
  'Virtual',
  'Not sure yet',
];
const budgetOptions = [
  'Prefer not to say',
  'Under $2,500',
  '$2,500–$5,000',
  '$5,000–$10,000',
  '$10,000+',
];
---
<form
  class="booking-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  data-booking-form
>
  <input type="hidden" name="access_key" value={ACCESS_KEY} />
  <input type="hidden" name="subject" value="Speaking inquiry — bryancutsinger.com" />
  <input type="hidden" name="from_name" value="Speaking inquiry" />
  <!-- honeypot: bots fill this; humans never see it -->
  <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

  <div class="booking-form__grid">
    <label class="field">
      <span>Your name <em>*</em></span>
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label class="field">
      <span>Email <em>*</em></span>
      <input type="email" name="email" required autocomplete="email" />
    </label>
    <label class="field">
      <span>Organization / institution <em>*</em></span>
      <input type="text" name="organization" required />
    </label>
    <label class="field">
      <span>Your role / title</span>
      <input type="text" name="role" />
    </label>
    <label class="field">
      <span>Event name</span>
      <input type="text" name="event_name" />
    </label>
    <label class="field">
      <span>Event date(s)</span>
      <input type="text" name="event_dates" placeholder="e.g. Oct 2026, or flexible" />
    </label>
    <label class="field">
      <span>Location</span>
      <input type="text" name="location" placeholder="City, or virtual" />
    </label>
    <label class="field">
      <span>Audience type</span>
      <select name="audience_type">
        <option value="">Select…</option>
        {audienceOptions.map((o) => <option value={o}>{o}</option>)}
      </select>
    </label>
    <label class="field">
      <span>Estimated audience size</span>
      <input type="text" name="audience_size" />
    </label>
    <label class="field">
      <span>Format</span>
      <select name="format">
        <option value="">Select…</option>
        {formatOptions.map((o) => <option value={o}>{o}</option>)}
      </select>
    </label>
    <label class="field field--full">
      <span>Budget range</span>
      <select name="budget">
        <option value="">Select…</option>
        {budgetOptions.map((o) => <option value={o}>{o}</option>)}
      </select>
    </label>
    <label class="field field--full">
      <span>Tell me about the event and what you're hoping for <em>*</em></span>
      <textarea name="message" rows="5" required></textarea>
    </label>
  </div>

  <div class="booking-form__actions">
    <button type="submit" class="booking-form__submit">Send inquiry</button>
    <p class="booking-form__alt">
      Prefer email? <a href={`mailto:${email}?subject=Speaking%20inquiry`}>{email}</a>
    </p>
  </div>

  <p class="booking-form__status" data-form-status role="status" aria-live="polite" hidden></p>
</form>

<script>
  const form = document.querySelector('[data-booking-form]') as HTMLFormElement | null;
  const status = document.querySelector('[data-form-status]') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    // If the access key is still the placeholder, let the normal POST happen so
    // it's obvious in testing; otherwise enhance with fetch.
    const key = (form.querySelector('[name="access_key"]') as HTMLInputElement)?.value;
    if (!key || key === 'YOUR_WEB3FORMS_ACCESS_KEY') return;

    e.preventDefault();
    if (status) {
      status.hidden = false;
      status.textContent = 'Sending…';
      status.className = 'booking-form__status is-pending';
    }
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const data = await res.json();
      if (data.success) {
        form.reset();
        if (status) {
          status.textContent =
            "Thank you — your inquiry is on its way. I'll be in touch shortly.";
          status.className = 'booking-form__status is-success';
        }
      } else {
        throw new Error(data.message || 'Submission failed');
      }
    } catch (err) {
      if (status) {
        status.textContent =
          'Something went wrong. Please email me directly and I’ll respond right away.';
        status.className = 'booking-form__status is-error';
      }
    }
  });
</script>

<style>
  .booking-form {
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--sp-8);
  }
  .booking-form__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-6);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .field span {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--text);
  }
  .field em {
    color: var(--accent);
    font-style: normal;
  }
  .field input,
  .field select,
  .field textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 11px 12px;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  .field textarea {
    resize: vertical;
  }

  .booking-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-6);
    margin-top: var(--sp-8);
  }
  .booking-form__submit {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    padding: 14px 28px;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--ink);
    border: 1px solid var(--accent);
    cursor: pointer;
    transition: background-color 0.18s ease;
  }
  .booking-form__submit:hover {
    background: var(--accent-hover);
    color: var(--on-ink);
  }
  .booking-form__alt {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .booking-form__status {
    margin: var(--sp-6) 0 0;
    padding: var(--sp-4);
    border-radius: var(--radius);
    font-size: 0.95rem;
  }
  .booking-form__status.is-success {
    background: var(--accent-tint);
    color: var(--ink);
  }
  .booking-form__status.is-error {
    background: #fbe6e0;
    color: #7a2e1a;
  }

  @media (max-width: 560px) {
    .booking-form__grid {
      grid-template-columns: 1fr;
    }
    .field--full {
      grid-column: auto;
    }
  }
</style>
