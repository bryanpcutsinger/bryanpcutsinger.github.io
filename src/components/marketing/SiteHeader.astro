---
// Sticky top nav for the marketing site. Wordmark left (mirrors the serif
// identity treatment of the Starlight SiteTitle override), uppercase label nav
// right, hamburger -> full-screen field overlay on mobile. No header CTA — the
// hero carries the single dominant action (v5 decision, 2026-07-22). Plain
// Astro + a tiny inline script for the mobile toggle (no framework).
interface Props {
  currentPath?: string;
}
const { currentPath = '' } = Astro.props;

const links = [
  { label: 'Speaking', href: '/speaking/' },
  { label: 'Writing', href: '/writing/' },
  { label: 'Research', href: '/research/' },
  { label: 'Teaching', href: '/teaching/' },
  { label: 'AI', href: '/ai/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

// normalize for active-state matching (trailing slash tolerant)
const norm = (p: string) => '/' + p.replace(/^\/|\/$/g, '');
const here = norm(currentPath);
const isActive = (href: string) =>
  here === norm(href) || (href !== '/' && here.startsWith(norm(href)));
---
<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a href="/" class="wordmark">Bryan&nbsp;Cutsinger</a>

    <nav class="nav-desktop" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['nav-link', { 'is-active': isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-nav-toggle
    >
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav class="mobile-menu__nav" aria-label="Mobile">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  // Mobile menu open/close — treated as a proper modal while open: focus moves
  // into the menu, Tab is contained, Escape closes, focus returns to the
  // toggle, the page behind is inert and scroll-locked. Everything is restored
  // symmetrically on close so no inert/overflow residue survives.
  let menuOpen = false;

  // The page behind the menu = every body child except the header (the menu
  // lives inside the header, which also keeps the toggle operable).
  const pageBehind = () =>
    Array.from(document.body.children).filter(
      (el) => el !== header && !['SCRIPT', 'STYLE'].includes(el.tagName),
    );

  // Focus targets while open: visible links/buttons in the header + menu
  // (the desktop nav is display:none at mobile widths, so it filters out).
  const focusables = () =>
    Array.from(
      header?.querySelectorAll<HTMLElement>('a[href], button:not([disabled])') ?? [],
    ).filter((el) => el.offsetParent !== null);

  function setMenuOpen(next: boolean) {
    if (!toggle || !menu || next === menuOpen) return;
    menuOpen = next;
    toggle.setAttribute('aria-expanded', String(next));
    toggle.setAttribute('aria-label', next ? 'Close menu' : 'Open menu');
    header?.classList.toggle('is-menu-open', next);
    menu.hidden = !next;
    document.body.style.overflow = next ? 'hidden' : '';
    for (const el of pageBehind()) {
      if (next) el.setAttribute('inert', '');
      else el.removeAttribute('inert');
    }
    if (next) menu.querySelector<HTMLElement>('a[href]')?.focus();
    else toggle.focus();
  }

  toggle?.addEventListener('click', () => setMenuOpen(!menuOpen));

  document.addEventListener('keydown', (e) => {
    if (!menuOpen) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      setMenuOpen(false);
      return;
    }
    if (e.key === 'Tab') {
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && (active === first || !items.includes(active as HTMLElement))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Close (and clean up) if the viewport crosses to the desktop layout, where
  // the CSS hides the menu but inert/scroll-lock would otherwise linger.
  const mobileMq = window.matchMedia('(max-width: 820px)');
  mobileMq.addEventListener('change', (e) => {
    if (!e.matches) setMenuOpen(false);
  });

  // solidify the bar once scrolled past the hero top
  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 24);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--ink);
    box-shadow: 0 1px 0 rgba(243, 239, 232, 0.08);
    transition: box-shadow 0.25s ease;
  }
  /* keep a firm edge once scrolled and while the mobile menu is open */
  .site-header.is-scrolled,
  .site-header.is-menu-open {
    box-shadow: 0 1px 0 rgba(243, 239, 232, 0.08);
  }

  .site-header__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--sp-4) var(--sp-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-6);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--on-ink);
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }
  .wordmark:hover {
    opacity: 0.85;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
  }
  .nav-link {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--on-field-muted);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover {
    color: var(--on-field);
    border-bottom-color: rgba(236, 233, 226, 0.4);
  }
  .nav-link.is-active {
    color: var(--on-field);
    border-bottom-color: var(--action-inverse);
  }

  /* hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .nav-toggle__bar {
    display: block;
    width: 24px;
    height: 2px;
    margin: 0 auto;
    background: var(--on-ink);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .is-menu-open .nav-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .is-menu-open .nav-toggle__bar:nth-child(2) {
    opacity: 0;
  }
  .is-menu-open .nav-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* mobile overlay menu */
  .mobile-menu {
    display: none;
  }
  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    padding: var(--sp-8) var(--sp-6) var(--sp-12);
  }
  .mobile-menu__nav a {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--on-ink);
    text-decoration: none;
  }
  .mobile-menu__nav a:hover {
    color: var(--action-inverse);
  }

  @media (max-width: 820px) {
    .nav-desktop {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
    .mobile-menu {
      display: block;
      background: var(--ink);
    }
    .mobile-menu[hidden] {
      display: none;
    }
  }
</style>
