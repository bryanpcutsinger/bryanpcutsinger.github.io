---
// Brand footer on the ink base. Wordmark + one-line positioning on the left,
// social/profile links on the right, copyright bar below. No duplicated
// sitemap (the sticky header carries the full nav on every page) and no raw
// email address (contact runs through /contact/ and the Speaking booking form).
const year = new Date().getFullYear();

// Real, verified profile URLs only (these also back the Person JSON-LD `sameAs`
// in MarketingLayout). Never add a placeholder/invented profile link here.
const social = [
  {
    label: 'X (Twitter)',
    href: 'https://x.com/BryanPCutsinger',
    icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/bryan-cutsinger-2654613a2/',
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z',
  },
  {
    label: 'Google Scholar',
    href: 'https://scholar.google.com/citations?user=j1xhP4kAAAAJ&hl=en',
    icon: 'M12 24a7 7 0 110-14 7 7 0 010 14zm0-24L0 9.5l4.838 3.94A8 8 0 0112 9a8 8 0 017.162 4.44L24 9.5z',
  },
];
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" class="footer-wordmark">Bryan&nbsp;Cutsinger</a>
      <p class="footer-tagline">Economist · Florida Atlantic University</p>
    </div>

    <nav class="site-footer__social" aria-label="Profiles">
      {social.map((s) => (
        <a href={s.href} aria-label={s.label} title={s.label} rel="me noopener" target="_blank">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d={s.icon} />
          </svg>
        </a>
      ))}
    </nav>
  </div>

  <div class="site-footer__credit">
    <p>© {year} Bryan Cutsinger</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--on-ink);
  }
  .site-footer__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--sp-16) var(--sp-6) var(--sp-12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-8);
    flex-wrap: wrap;
  }
  .footer-wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--on-ink);
    text-decoration: none;
  }
  .footer-tagline {
    margin: var(--sp-2) 0 0;
    color: var(--on-ink-muted);
    font-size: var(--fs-small);
    max-width: none;
  }
  .site-footer__social {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
  }
  .site-footer__social a {
    color: var(--on-ink-muted);
    display: inline-flex;
    transition: color 0.15s ease;
  }
  .site-footer__social a:hover {
    color: var(--accent-on-ink);
  }
  .site-footer__credit {
    border-top: 1px solid rgba(243, 239, 232, 0.12);
  }
  .site-footer__credit p {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--sp-6);
    font-size: var(--fs-small);
    color: var(--on-ink-muted);
  }

  @media (max-width: 700px) {
    .site-footer__inner {
      padding-top: var(--sp-12);
    }
  }
</style>
