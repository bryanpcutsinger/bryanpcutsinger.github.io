---
// Single variant-driven button/link used across the marketing site so styling
// stays consistent. Renders an <a> (it's always a navigation/CTA here).
// v5 variants:
//   'action'         — red fill (the default CTA on light surfaces)
//   'action-inverse' — light-red fill with field text (the CTA on dark fields)
//   'secondary'      — restrained 1px outline (downloads, secondary actions)
//   'ghost-ink'      — outline on dark fields
//   'quiet'          — uppercase text link, no box
// Legacy names accepted during migration (retire in cleanup):
//   'primary'→action · 'on-ink'/'on-claret'→action-inverse · 'ghost-claret'→ghost-ink
interface Props {
  href: string;
  variant?:
    | 'action'
    | 'action-inverse'
    | 'secondary'
    | 'ghost-ink'
    | 'quiet'
    | 'primary'
    | 'on-ink'
    | 'on-claret'
    | 'ghost-claret';
  class?: string;
}
const { href, variant = 'action', class: className = '' } = Astro.props;
const resolved =
  variant === 'primary'
    ? 'action'
    : variant === 'on-ink' || variant === 'on-claret'
      ? 'action-inverse'
      : variant === 'ghost-claret'
        ? 'ghost-ink'
        : variant;
---
<a href={href} class:list={['btn', `btn--${resolved}`, className]}>
  <slot />
</a>

<style>
  .btn {
    display: inline-block;
    font-family: var(--font-label);
    font-weight: 650;
    font-size: 0.84rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius);
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease,
      border-color 0.18s ease;
    white-space: nowrap;
  }

  /* action: red fill — the dominant CTA on light surfaces */
  .btn--action {
    background: var(--action);
    color: var(--on-action);
    border-color: var(--action);
  }
  .btn--action:hover {
    background: var(--action-hover);
    border-color: var(--action-hover);
    color: var(--on-action);
  }

  /* action-inverse: light-red fill, field text — the CTA on dark fields */
  .btn--action-inverse {
    background: var(--action-inverse);
    color: var(--field);
    border-color: var(--action-inverse);
  }
  .btn--action-inverse:hover {
    background: var(--action-inverse-hover);
    border-color: var(--action-inverse-hover);
    color: var(--field);
  }

  /* secondary: restrained outline on light surfaces */
  .btn--secondary {
    background: transparent;
    color: var(--text);
    border-color: var(--text);
  }
  .btn--secondary:hover {
    background: var(--field);
    border-color: var(--field);
    color: var(--on-field);
  }

  /* ghost-ink: outline on dark fields */
  .btn--ghost-ink {
    background: transparent;
    color: var(--on-field);
    border-color: rgba(236, 233, 226, 0.5);
  }
  .btn--ghost-ink:hover {
    background: rgba(236, 233, 226, 0.12);
    color: var(--on-field);
    border-color: var(--on-field);
  }

  /* quiet: uppercase text link, no box */
  .btn--quiet {
    background: transparent;
    border: 0;
    padding: 0.85rem 0;
    color: var(--action);
  }
  .btn--quiet:hover {
    color: var(--action-hover);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
