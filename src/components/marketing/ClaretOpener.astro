---
// ClaretOpener — the full-bleed claret "first screen" that replaces the ink hero
// on the home / Speaking / About pages. Bold color + scale above the fold: a mono
// running line, an oversized Newsreader nameplate (roman + italic), and an
// optional framed author-plate. Page-authored (placed as the first slot child of
// MarketingLayout) — NOT a layout prop — so it never double-stacks. It pads its
// own top by --header-h instead of the old negative-margin hack.
//
// Rich headline markup goes in the `headline` slot; otherwise the `headline`
// string is used. A portrait goes in the `media` slot.
import Button from './Button.astro';

interface Props {
  runline?: string; // e.g. "Economist · Writing · Speaking · Teaching"
  edition?: string; // optional right-aligned label (dept / locale)
  headline: string;
  subhead?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  plateName?: string;
  plateRole?: string;
}
const {
  runline,
  edition,
  headline,
  subhead,
  primaryCta,
  secondaryCta,
  plateName,
  plateRole,
} = Astro.props;
const hasMedia = Astro.slots.has('media');
const hasHeadlineSlot = Astro.slots.has('headline');
const hasPlateCap = !!(plateName || plateRole);
---
<section class="opener" data-has-media={hasMedia}>
  <div class="opener__inner">
    {
      (runline || edition) && (
        <div class="opener__runline">
          <span>{runline}</span>
          {edition && <span class="opener__edition">{edition}</span>}
        </div>
      )
    }
    <div class="opener__grid">
      <div class="opener__copy">
        <h1 class="opener__headline">
          {hasHeadlineSlot ? <slot name="headline" /> : headline}
        </h1>
        {subhead && <p class="opener__subhead">{subhead}</p>}
        {
          (primaryCta || secondaryCta) && (
            <div class="opener__actions">
              {primaryCta && (
                <Button href={primaryCta.href} variant="on-claret">
                  {primaryCta.label}
                </Button>
              )}
              {secondaryCta && (
                <Button href={secondaryCta.href} variant="ghost-claret">
                  {secondaryCta.label}
                </Button>
              )}
            </div>
          )
        }
      </div>
      {
        hasMedia && (
          <figure class="opener__plate">
            <div class="opener__plate-img">
              <slot name="media" />
            </div>
            {hasPlateCap && (
              <figcaption class="opener__plate-cap">
                {plateName && <span class="opener__plate-name">{plateName}</span>}
                {plateRole && <span class="opener__plate-role">{plateRole}</span>}
              </figcaption>
            )}
          </figure>
        )
      }
    </div>
  </div>
</section>

<style>
  .opener {
    background: linear-gradient(157deg, var(--claret-deep), var(--accent) 72%);
    color: var(--on-claret);
    padding-block: calc(var(--header-h) + clamp(2.5rem, 1.5rem + 5vw, 5rem))
      var(--section-y-ink);
  }
  .opener__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--sp-6);
  }

  /* running line — the masthead device, over a cream hairline */
  .opener__runline {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-4);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--on-claret-muted);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--claret-hairline);
    margin-bottom: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }
  .opener__edition {
    text-align: right;
  }

  .opener__grid {
    display: grid;
    gap: clamp(2rem, 1rem + 5vw, var(--sp-24));
    align-items: center;
  }
  .opener[data-has-media='true'] .opener__grid {
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
  }

  .opener__headline {
    font-family: var(--font-display);
    font-size: var(--fs-nameplate);
    font-weight: 420;
    line-height: 1.0;
    letter-spacing: -0.024em;
    color: var(--on-claret);
    margin: 0;
    max-width: 15ch;
    text-wrap: balance;
  }
  .opener__headline :global(em) {
    font-style: italic;
    color: var(--on-claret-muted);
  }

  .opener__subhead {
    font-family: var(--font-body);
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--on-claret-muted);
    margin: var(--sp-8) 0 0;
    max-width: 52ch;
  }
  .opener__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-8);
  }

  /* author plate: framed portrait + a mono credit caption under a cream rule */
  .opener__plate {
    margin: 0;
  }
  .opener__plate-img :global(img) {
    border-radius: var(--radius);
    width: 100%;
    object-fit: cover;
    box-shadow: inset 0 0 0 1px var(--claret-hairline);
  }
  .opener__plate-cap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--claret-hairline);
  }
  .opener__plate-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--on-claret);
  }
  .opener__plate-role {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-claret-muted);
  }

  @media (max-width: 820px) {
    .opener[data-has-media='true'] .opener__grid {
      grid-template-columns: 1fr;
    }
    .opener__plate {
      max-width: 320px;
    }
    .opener__runline {
      flex-wrap: wrap;
      font-size: 0.64rem;
      letter-spacing: 0.14em;
    }
    .opener__edition {
      display: none;
    }
  }
</style>
