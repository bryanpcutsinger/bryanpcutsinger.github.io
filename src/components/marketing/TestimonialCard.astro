---
// A single named testimonial. Named attribution only (per integrity rule) —
// no anonymous quotes on the speaker pages.
interface Props {
  quote: string;
  name: string;
  role?: string;
  org?: string;
}
const { quote, name, role, org } = Astro.props;
const attribution = [role, org].filter(Boolean).join(', ');
---
<figure class="testimonial">
  <blockquote class="testimonial__quote">
    <p>{quote}</p>
  </blockquote>
  <figcaption class="testimonial__cite">
    <span class="testimonial__name">{name}</span>
    {attribution && <span class="testimonial__role">{attribution}</span>}
  </figcaption>
</figure>

<style>
  .testimonial {
    margin: 0;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--sp-8);
    position: relative;
    height: 100%;
  }
  .testimonial::before {
    content: '\201C';
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 1;
    color: var(--accent-tint);
    position: absolute;
    top: var(--sp-4);
    left: var(--sp-6);
  }
  .testimonial__quote {
    margin: var(--sp-6) 0 0;
    position: relative;
  }
  .testimonial__quote p {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--ink);
    margin: 0;
    max-width: none;
  }
  .testimonial__cite {
    margin-top: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .testimonial__name {
    font-weight: 600;
    color: var(--text);
  }
  .testimonial__role {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
</style>
