---
// EditorialIndex — the signature structural pattern. A real ordered list where
// giant claret folio numerals carry an asymmetric left-rail grid; title in large
// Newsreader, meta in mono, optional dek. Rows link only when a real `href` is
// given (no dangling dot-leaders). Replaces the boxed TopicGrid/TopicCard.
//
// items: { title, meta?, dek?, href? }[]  — meta is a short mono line
//        (e.g. "Keynote · General audiences" or "Speaking →").
interface Item {
  title: string;
  meta?: string;
  dek?: string;
  href?: string;
}
interface Props {
  items: Item[];
  start?: number; // first folio number (default 1)
  class?: string;
}
const { items, start = 1, class: className = '' } = Astro.props;
const folio = (i: number) => String(start + i).padStart(2, '0');
---
<ol class:list={['eidx', className]}>
  {
    items.map((item, i) => {
      const Tag = item.href ? 'a' : 'div';
      return (
        <li class="eidx__item">
          <Tag
            class:list={['eidx__row', { 'is-link': !!item.href }]}
            href={item.href}
          >
            <span class="eidx__folio" aria-hidden="true">
              {folio(i)}
            </span>
            <span class="eidx__body">
              <span class="eidx__title">{item.title}</span>
              {item.meta && <span class="eidx__meta">{item.meta}</span>}
              {item.dek && <span class="eidx__dek">{item.dek}</span>}
            </span>
            {item.href && <span class="eidx__arrow" aria-hidden="true">→</span>}
          </Tag>
        </li>
      );
    })
  }
</ol>

<style>
  .eidx {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .eidx__item {
    border-bottom: 1px solid var(--rule);
  }

  .eidx__row {
    display: grid;
    grid-template-columns: minmax(3.25rem, 5.5rem) 1fr auto;
    align-items: baseline;
    gap: var(--sp-4) clamp(var(--sp-4), 2vw, var(--sp-8));
    padding: clamp(var(--sp-6), 3vw, var(--sp-8)) 0;
    text-decoration: none;
    color: var(--text);
  }

  .eidx__folio {
    font-family: var(--font-display);
    font-size: var(--fs-folio);
    font-weight: 380;
    line-height: 0.9;
    color: var(--accent);
    font-variant-numeric: lining-nums;
    letter-spacing: -0.02em;
  }

  .eidx__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .eidx__title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 1.1vw, 1.85rem);
    font-weight: 460;
    line-height: 1.12;
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  .eidx__meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .eidx__dek {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 54ch;
  }

  .eidx__arrow {
    align-self: center;
    font-size: 1.25rem;
    color: var(--text-muted);
    transition: transform 0.18s ease, color 0.18s ease;
  }

  /* linked rows: warm wash + folio/title/arrow pick up claret on hover */
  .eidx__row.is-link:hover {
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }
  .eidx__row.is-link:hover .eidx__title {
    color: var(--accent);
  }
  .eidx__row.is-link:hover .eidx__arrow {
    color: var(--accent);
    transform: translateX(4px);
  }
  .eidx__row.is-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  @media (max-width: 640px) {
    .eidx__row {
      grid-template-columns: minmax(2.5rem, auto) 1fr;
      gap: var(--sp-3) var(--sp-4);
    }
    /* arrow rides up next to the folio so the body keeps full width */
    .eidx__arrow {
      display: none;
    }
  }
</style>
