---
// CloseBand — the closing call-to-action band on the navy field for interior
// pages (Writing, Research, About…). A Besley heading, a line of subtext, and
// one action-inverse button. No kicker eyebrow (v5); the prop is accepted for
// back-compat but not rendered.
import Button from './Button.astro';
interface Props {
  kicker?: string;
  heading: string;
  subtext?: string;
  cta: { label: string; href: string };
}
const { heading, subtext, cta } = Astro.props;
---
<section class="close">
  <div class="close__inner">
    <h2 class="close__heading">{heading}</h2>
    {subtext && <p class="close__sub">{subtext}</p>}
    <div class="close__cta">
      <Button href={cta.href} variant="action-inverse">{cta.label}</Button>
    </div>
  </div>
</section>

<style>
  .close {
    background: var(--ink);
    color: var(--on-ink);
    padding-block: var(--section-y-ink);
  }
  .close__inner {
    max-width: var(--reading);
    margin-inline: auto;
    padding-inline: var(--sp-6);
  }
  .close__heading {
    color: var(--on-ink);
    font-size: var(--fs-h2);
    max-width: 20ch;
    margin: 0 0 var(--sp-4);
  }
  .close__sub {
    color: var(--on-ink-muted);
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: 52ch;
    margin: 0 0 var(--sp-8);
  }
  .close__sub :global(a) { color: var(--accent-on-ink); }
</style>
