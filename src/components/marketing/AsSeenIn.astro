---
// "Featured in" masthead row. Renders text wordmarks (logos optional). Centers
// when there are few items. GRACEFUL-EMPTY: renders nothing when no logos.
interface Logo {
  name: string;
  href?: string;
}
interface Props {
  label?: string;
  logos: Logo[];
}
const { label = 'Featured in', logos } = Astro.props;
---
{
  logos.length > 0 && (
    <div class="as-seen-in">
      <p class="as-seen-in__label">{label}</p>
      <ul class:list={['as-seen-in__list', { 'is-few': logos.length <= 3 }]}>
        {logos.map((l) => (
          <li>
            {l.href ? (
              <a href={l.href} rel="noopener">
                {l.name}
              </a>
            ) : (
              <span>{l.name}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .as-seen-in {
    text-align: center;
  }
  .as-seen-in__label {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 var(--sp-6);
    max-width: none;
  }
  .as-seen-in__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sp-8) var(--sp-12);
  }
  .as-seen-in__list li {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.9rem + 0.8vw, 1.5rem);
    font-weight: 500;
    color: var(--slate);
    font-style: italic;
  }
  .as-seen-in__list a {
    color: inherit;
    text-decoration: none;
  }
  .as-seen-in__list a:hover {
    color: var(--ink);
  }
</style>
