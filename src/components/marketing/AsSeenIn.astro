---
// "Featured in" masthead row. Renders text wordmarks (logos optional). Centers
// when there are few items. GRACEFUL-EMPTY: renders nothing when no logos.
interface Logo {
  name: string;
  href?: string;
}
interface Props {
  label?: string;
  logos: Logo[];
}
const { label = 'Featured in', logos } = Astro.props;
---
{
  logos.length > 0 && (
    <div class="as-seen-in">
      <p class="as-seen-in__label">{label}</p>
      <ul class:list={['as-seen-in__list', { 'is-few': logos.length <= 3 }]}>
        {logos.map((l) => (
          <li>
            {l.href ? (
              <a href={l.href} rel="noopener">
                {l.name}
              </a>
            ) : (
              <span>{l.name}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .as-seen-in {
    text-align: center;
  }
  .as-seen-in__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 var(--sp-6);
    max-width: none;
  }
  /* short hairline rule under the label — a masthead device */
  .as-seen-in__label::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--rule);
    margin: var(--sp-3) auto 0;
  }
  .as-seen-in__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--sp-6) var(--sp-12);
  }
  .as-seen-in__list li {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.9rem + 0.7vw, 1.4rem);
    font-weight: 480;
    color: var(--slate);
    letter-spacing: -0.005em;
  }
  .as-seen-in__list a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .as-seen-in__list a:hover {
    color: var(--accent);
  }
</style>
