---
// PageHead — the interior-page header (Speaking / Writing / Research / About).
// Lighter than the Home masthead: a kicker + edition bracketed by an ink hairline,
// a Fraunces H1, and an optional lede. Sits under the sticky header and pads its
// own top by --header-h. Rich H1 markup via the `headline` slot.
interface Props {
  kicker: string;
  edition?: string;
  headline: string;
  lede?: string;
}
const { kicker, edition, headline, lede } = Astro.props;
const hasHeadlineSlot = Astro.slots.has('headline');
---
<header class="phead">
  <div class="phead__inner">
    <div class="phead__runline">
      <span class="label label--accent">{kicker}</span>
      {edition && <span class="label phead__edition">{edition}</span>}
    </div>
    <h1 class="phead__headline">
      {hasHeadlineSlot ? <slot name="headline" /> : headline}
    </h1>
    {lede && <p class="phead__lede lede">{lede}</p>}
  </div>
</header>

<style>
  .phead {
    background: var(--paper);
    padding-top: calc(var(--header-h) + var(--sp-16));
    padding-bottom: var(--sp-12);
  }
  .phead__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--sp-6);
  }
  .phead__runline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 2px solid var(--ink);
    margin-bottom: var(--sp-8);
  }
  .phead__edition { color: var(--muted); }
  .phead__headline {
    font-size: var(--fs-display);
    line-height: 1.03;
    letter-spacing: -0.018em;
    margin: 0;
    max-width: 20ch;
  }
  .phead__headline :global(em) { font-style: italic; color: var(--accent); }
  .phead__lede { margin: var(--sp-6) 0 0; }

  @media (max-width: 640px) {
    .phead { padding-top: calc(var(--header-h) + var(--sp-8)); }
    .phead__edition { display: none; }
  }
</style>
