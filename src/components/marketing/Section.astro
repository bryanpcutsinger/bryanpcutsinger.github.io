---
// Vertical-rhythm section wrapper with a background variant + a centered
// container. Use `width="reading"` for long-form text (680px), default is the
// wide 1120px container.
//   variant: 'surface' (bone) | 'ink' (dark) | 'raised' (white)
interface Props {
  variant?: 'surface' | 'ink' | 'raised';
  width?: 'wide' | 'reading';
  id?: string;
  class?: string;
}
const {
  variant = 'surface',
  width = 'wide',
  id,
  class: className = '',
} = Astro.props;
---
<section
  id={id}
  class:list={['section', `section--${variant}`, className]}
>
  <div class:list={['section__inner', `section__inner--${width}`]}>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-y);
  }
  .section--surface {
    background: var(--surface);
    color: var(--text);
  }
  .section--raised {
    background: var(--surface-raised);
    color: var(--text);
  }
  .section--ink {
    background: var(--ink);
    color: var(--on-ink);
    padding-block: var(--section-y-ink);
  }
  /* headings invert on ink */
  .section--ink :global(h1),
  .section--ink :global(h2),
  .section--ink :global(h3) {
    color: var(--on-ink);
  }

  .section__inner {
    margin-inline: auto;
    padding-inline: var(--sp-6);
  }
  .section__inner--wide {
    max-width: var(--container);
  }
  .section__inner--reading {
    max-width: var(--reading);
  }
</style>
