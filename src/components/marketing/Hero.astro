---
// Page hero on the ink base. Text-forward; an optional `media` slot takes an
// <Image> (astro:assets) so it works gracefully with OR without a photo —
// when no media is slotted, the copy spans full width.
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  subhead?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}
const { eyebrow, headline, subhead, primaryCta, secondaryCta } = Astro.props;
const hasMedia = Astro.slots.has('media');
---
<section class="hero" data-has-media={hasMedia}>
  <div class="hero__inner">
    <div class="hero__copy">
      {eyebrow && <Eyebrow text={eyebrow} />}
      <h1 class="hero__headline">{headline}</h1>
      {subhead && <p class="hero__subhead">{subhead}</p>}
      {
        (primaryCta || secondaryCta) && (
          <div class="hero__actions">
            {primaryCta && (
              <Button href={primaryCta.href} variant="primary">
                {primaryCta.label}
              </Button>
            )}
            {secondaryCta && (
              <Button href={secondaryCta.href} variant="ghost-ink">
                {secondaryCta.label}
              </Button>
            )}
          </div>
        )
      }
    </div>
    {
      hasMedia && (
        <div class="hero__media">
          <slot name="media" />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    background: var(--ink);
    color: var(--on-ink);
    /* pull up under the transparent sticky header */
    padding-block: clamp(6rem, 4rem + 10vw, 10rem) var(--section-y-ink);
    margin-top: -78px; /* header height: sits hero behind the bar */
  }
  .hero__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--sp-6);
    display: grid;
    gap: var(--sp-12);
    align-items: center;
  }
  .hero[data-has-media='true'] .hero__inner {
    grid-template-columns: 1.1fr 0.9fr;
  }

  .hero__headline {
    font-size: var(--fs-display-xl);
    color: var(--on-ink);
    margin: 0;
    max-width: 16ch;
  }
  .hero__subhead {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--on-ink-muted);
    margin: var(--sp-6) 0 0;
    max-width: 56ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-8);
  }

  .hero__media :global(img) {
    border-radius: var(--radius-lg);
    width: 100%;
    object-fit: cover;
  }

  @media (max-width: 820px) {
    .hero[data-has-media='true'] .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__media {
      order: -1;
      max-width: 360px;
    }
  }
</style>
