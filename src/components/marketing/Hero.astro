---
// Editorial "featured essay" hero on the ink base. A masthead dateline (a mono
// label pair over a full-width hairline rule) sits above an oversized headline
// that can mix roman + italic, with the portrait treated as an author plate
// (framed photo + a mono credit caption). All of the editorial furniture is
// opt-in so text-only heroes on other pages stay clean but still get the larger
// type. Pass rich headline markup via the `headline` slot; otherwise the
// `headline` string is used.
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  subhead?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  datelineLeft?: string;
  datelineRight?: string;
  plateName?: string;
  plateRole?: string;
}
const {
  eyebrow,
  headline,
  subhead,
  primaryCta,
  secondaryCta,
  datelineLeft,
  datelineRight,
  plateName,
  plateRole,
} = Astro.props;
const hasMedia = Astro.slots.has('media');
const hasHeadlineSlot = Astro.slots.has('headline');
const hasDateline = !!(datelineLeft || datelineRight);
const hasPlateCap = !!(plateName || plateRole);
---
<section class="hero" data-has-media={hasMedia}>
  <div class="hero__inner">
    {
      hasDateline && (
        <div class="hero__dateline">
          <span>{datelineLeft}</span>
          <span>{datelineRight}</span>
        </div>
      )
    }
    <div class="hero__grid">
      <div class="hero__copy">
        {eyebrow && <Eyebrow text={eyebrow} />}
        <h1 class="hero__headline">
          {hasHeadlineSlot ? <slot name="headline" /> : headline}
        </h1>
        {subhead && <p class="hero__subhead">{subhead}</p>}
        {
          (primaryCta || secondaryCta) && (
            <div class="hero__actions">
              {primaryCta && (
                <Button href={primaryCta.href} variant="action-inverse">
                  {primaryCta.label}
                </Button>
              )}
              {secondaryCta && (
                <Button href={secondaryCta.href} variant="ghost-ink">
                  {secondaryCta.label}
                </Button>
              )}
            </div>
          )
        }
      </div>
      {
        hasMedia && (
          <figure class="hero__plate">
            <div class="hero__plate-img">
              <slot name="media" />
            </div>
            {hasPlateCap && (
              <figcaption class="hero__plate-cap">
                {plateName && <span class="hero__plate-name">{plateName}</span>}
                {plateRole && <span class="hero__plate-role">{plateRole}</span>}
              </figcaption>
            )}
          </figure>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--ink);
    color: var(--on-ink);
    padding-block: clamp(5.5rem, 4rem + 9vw, 9rem) var(--section-y-ink);
    margin-top: -78px; /* header height: sits hero behind the transparent bar */
  }
  .hero__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--sp-6);
  }

  /* masthead dateline — a mono label pair over a full-width hairline rule */
  .hero__dateline {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-4);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid rgba(242, 239, 231, 0.18);
    margin-bottom: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }
  .hero__dateline span:last-child {
    text-align: right;
  }

  .hero__grid {
    display: grid;
    gap: clamp(2rem, 1rem + 5vw, var(--sp-24));
    align-items: center;
  }
  .hero[data-has-media='true'] .hero__grid {
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
  }

  .hero__headline {
    font-size: var(--fs-mast);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.022em;
    color: var(--on-ink);
    margin: 0;
    max-width: 16ch;
  }
  .hero__headline :global(em) {
    font-style: italic;
    color: var(--action-inverse);
  }

  .hero__subhead {
    font-family: var(--font-body);
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--on-ink-muted);
    margin: var(--sp-8) 0 0;
    max-width: 52ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-8);
  }

  /* author plate: framed portrait + a mono credit caption under a hairline */
  .hero__plate {
    margin: 0;
  }
  .hero__plate-img :global(img) {
    border-radius: var(--radius);
    width: 100%;
    object-fit: cover;
    box-shadow: inset 0 0 0 1px rgba(242, 239, 231, 0.16);
  }
  .hero__plate-cap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px solid rgba(242, 239, 231, 0.2);
  }
  .hero__plate-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--on-ink);
  }
  .hero__plate-role {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
  }

  @media (max-width: 820px) {
    .hero[data-has-media='true'] .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__plate {
      max-width: 340px;
    }
    .hero__dateline {
      font-size: 0.66rem;
      letter-spacing: 0.12em;
    }
  }
</style>
