---
// EmailCapture — a quiet essays/updates signup. The conversion/funnel piece the
// site otherwise lacked. GRACEFUL + honest: until a real provider endpoint exists
// it degrades to a mailto so it's never a dead form. Pass `action` (a Web3Forms /
// Buttondown / ConvertKit POST URL) to make it live.
//
// [PLACEHOLDER] Bryan still owes a real list provider + endpoint. Until then this
// posts nowhere; the mailto fallback below keeps it functional.
interface Props {
  heading?: string;
  blurb?: string;
  action?: string; // real form endpoint; when absent, uses the mailto fallback
  mailto?: string;
}
const {
  heading = 'Get new essays by email',
  blurb = 'Occasional notes on money, inflation, and the political economy of policy. No spam; unsubscribe anytime.',
  action,
  mailto = 'bcutsinger@fau.edu',
} = Astro.props;
const live = !!action;
---
<div class="capture">
  <div class="capture__copy">
    <p class="kicker">Stay in touch</p>
    <h2 class="capture__heading">{heading}</h2>
    <p class="capture__blurb">{blurb}</p>
  </div>

  {
    live ? (
      <form class="capture__form" action={action} method="POST">
        <label class="visually-hidden" for="capture-email">
          Email address
        </label>
        <input
          id="capture-email"
          class="capture__input"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@university.edu"
        />
        <button class="capture__btn" type="submit">Subscribe</button>
      </form>
    ) : (
      <p class="capture__fallback">
        <a
          href={`mailto:${mailto}?subject=${encodeURIComponent('Add me to your essays list')}`}
        >
          Email me to be added to the list ↗
        </a>
        <span class="capture__soon label">Signup form coming soon</span>
      </p>
    )
  }
</div>

<style>
  .capture {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--sp-12);
    align-items: center;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--hairline);
    padding-block: var(--sp-12);
  }
  .capture__heading {
    font-size: var(--fs-h2);
    margin: 0 0 var(--sp-3);
  }
  .capture__blurb {
    margin: 0;
    color: var(--muted);
    max-width: 46ch;
  }
  .capture__form {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }
  .capture__input {
    flex: 1 1 14rem;
    font-family: var(--font-label);
    font-size: 1rem;
    padding: 14px 16px;
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    color: var(--ink);
  }
  .capture__input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  .capture__btn {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    padding: 14px 26px;
    background: var(--accent);
    color: var(--on-ink);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    cursor: pointer;
    transition: background-color 0.18s ease;
  }
  .capture__btn:hover { background: var(--accent-hover); }

  .capture__fallback {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    align-items: flex-start;
  }
  .capture__soon { color: var(--muted); }

  @media (max-width: 720px) {
    .capture {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }
  }
</style>
