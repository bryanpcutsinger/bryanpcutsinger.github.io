---
// A speaking topic / signature talk. On the homepage it links to /speaking;
// on the Speaking page it can render link-free.
interface Props {
  title: string;
  description: string;
  audience?: string; // "best for" tag
  format?: string; // keynote / lecture / workshop
  href?: string;
}
const { title, description, audience, format, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['topic-card', { 'is-link': !!href }]} href={href}>
  {format && <span class="topic-card__format">{format}</span>}
  <h3 class="topic-card__title">{title}</h3>
  <p class="topic-card__desc">{description}</p>
  {audience && <p class="topic-card__audience">Best for: {audience}</p>}
</Tag>

<style>
  .topic-card {
    display: block;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--sp-8);
    text-decoration: none;
    color: var(--text);
    height: 100%;
    transition: border-color 0.18s ease, box-shadow 0.18s ease,
      transform 0.18s ease;
  }
  .topic-card.is-link:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }
  .topic-card__format {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-4);
  }
  .topic-card__title {
    font-size: var(--fs-h3);
    font-weight: 500;
    margin: 0 0 var(--sp-3);
  }
  .topic-card__desc {
    color: var(--text-muted);
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
  }
  .topic-card__audience {
    margin: var(--sp-4) 0 0;
    font-size: var(--fs-small);
    color: var(--text);
    font-weight: 500;
  }
</style>
